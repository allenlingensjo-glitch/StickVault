<%- include('../partials/head', { title: 'Affiliate Links — StickVault Admin' }) %>
<%- include('../partials/nav') %>

<style>
  .admin-wrap { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem 5rem; }
  .admin-header { margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .admin-header-text h1 { font-family: var(--font-display); font-size: 2rem; font-weight: 900; color: var(--text-primary); margin: 0 0 0.3rem; }
  .admin-header-text p  { color: var(--text-secondary); font-size: 0.88rem; margin: 0; }
  .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1.1rem; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; border: 1px solid transparent; text-decoration: none; transition: opacity 0.15s; }
  .btn:hover { opacity: 0.85; }
  .btn-primary  { background: var(--accent, #d4af37); color: #0a0a0a; }
  .btn-ghost    { background: transparent; color: var(--text-secondary); border-color: var(--border); }
  .btn-danger   { background: transparent; color: #e05252; border-color: #e05252; }
  .btn-sm { padding: 0.35rem 0.75rem; font-size: 0.78rem; }

  /* Stats bar */
  .stats-bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
  @media (max-width: 700px) { .stats-bar { grid-template-columns: 1fr 1fr; } }
  .stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.25rem; }
  .stat-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary); margin-bottom: 0.3rem; }
  .stat-value { font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: var(--text-primary); }

  /* Add link form */
  .add-form-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 2rem; }
  .add-form-card h2 { font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 1rem; }
  .form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem; }
  .form-grid-wide { grid-column: 1 / -1; }
  .form-field { display: flex; flex-direction: column; gap: 0.3rem; }
  .form-field label { font-size: 0.78rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; }
  .form-field input, .form-field select {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-primary);
    font-size: 0.88rem;
    padding: 0.5rem 0.75rem;
    width: 100%;
    box-sizing: border-box;
  }
  .form-field input:focus, .form-field select:focus { outline: none; border-color: var(--accent, #d4af37); }
  .form-actions { display: flex; gap: 0.5rem; margin-top: 1rem; }

  /* Links table */
  .links-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  .links-card-header { padding: 1rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .links-card-header h2 { font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.08em; margin: 0; }
  .header-actions { display: flex; gap: 0.5rem; align-items: center; }

  .links-table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
  .links-table th { text-align: left; padding: 0.6rem 0.75rem; color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.07em; border-bottom: 1px solid var(--border); white-space: nowrap; }
  .links-table td { padding: 0.65rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .links-table tr:last-child td { border-bottom: none; }
  .links-table tr:hover td { background: rgba(255,255,255,0.02); }

  .slug-cell  { font-family: var(--font-mono, monospace); color: var(--accent, #d4af37); font-size: 0.8rem; }
  .url-cell   { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-secondary); font-size: 0.78rem; }
  .badge { display: inline-block; padding: 0.15rem 0.55rem; border-radius: 20px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .badge-affiliate  { background: rgba(212,175,55,0.15); color: var(--accent, #d4af37); }
  .badge-partner    { background: rgba(80,160,255,0.15); color: #50a0ff; }
  .badge-recommended{ background: rgba(80,200,140,0.15); color: #50c88c; }
  .badge-internal   { background: rgba(160,160,160,0.15); color: #aaa; }
  .status-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; }
  .status-active   { background: #50c88c; }
  .status-inactive { background: #e05252; }

  .click-count { font-family: var(--font-mono, monospace); font-weight: 700; color: var(--text-primary); }

  /* Inline edit row */
  .edit-row td { background: rgba(212,175,55,0.04); border-top: 1px solid var(--accent, #d4af37); border-bottom: 1px solid var(--accent, #d4af37); }
  .edit-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr auto; gap: 0.5rem; align-items: end; }
  .edit-grid input, .edit-grid select { background: var(--bg); border: 1px solid var(--border); border-radius: 5px; color: var(--text-primary); font-size: 0.82rem; padding: 0.4rem 0.6rem; width: 100%; box-sizing: border-box; }
  .edit-actions { display: flex; gap: 0.4rem; flex-shrink: 0; }

  /* Toast */
  #toast { position: fixed; bottom: 1.5rem; right: 1.5rem; background: #1a1a1a; border: 1px solid var(--accent, #d4af37); color: var(--text-primary); padding: 0.75rem 1.25rem; border-radius: 8px; font-size: 0.85rem; z-index: 999; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
  #toast.show { opacity: 1; }

  .empty-state { padding: 3rem; text-align: center; color: var(--text-secondary); font-size: 0.9rem; }

  .check-status { font-family: var(--font-mono, monospace); font-size: 0.78rem; }
  .check-ok   { color: #50c88c; }
  .check-warn { color: var(--accent, #d4af37); }
  .check-fail { color: #e05252; }
</style>

<div class="admin-wrap">
  <div class="admin-header">
    <div class="admin-header-text">
      <h1>🔗 Affiliate Links</h1>
      <p>Manage branded redirects, track clicks, and run broken-link audits.</p>
    </div>
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
      <button class="btn btn-ghost btn-sm" onclick="exportCSV()">⬇ Export CSV</button>
      <button class="btn btn-ghost btn-sm" id="check-btn" onclick="checkAllLinks()">🔍 Check All Links</button>
      <a href="/affiliate-disclosure" target="_blank" class="btn btn-ghost btn-sm">📄 Disclosure Page</a>
    </div>
  </div>

  <!-- Stats -->
  <div class="stats-bar">
    <div class="stat-card">
      <div class="stat-label">Total Links</div>
      <div class="stat-value" id="stat-total"><%= links.length %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Active</div>
      <div class="stat-value" id="stat-active"><%= links.filter(l => l.is_active).length %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total Clicks</div>
      <div class="stat-value" id="stat-clicks"><%= links.reduce((a, l) => a + l.click_count, 0) %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Broken</div>
      <div class="stat-value" id="stat-broken" style="color:#e05252"><%= links.filter(l => l.last_status >= 400).length %></div>
    </div>
  </div>

  <!-- Add new link -->
  <div class="add-form-card">
    <h2>Add New Link</h2>
    <form id="add-form" onsubmit="submitAddForm(event)">
      <div class="form-grid">
        <div class="form-field">
          <label>Slug *</label>
          <input name="slug" placeholder="drum-blueprint-rb" required pattern="[a-z0-9\-]+" title="lowercase letters, numbers, hyphens">
        </div>
        <div class="form-field">
          <label>Label *</label>
          <input name="label" placeholder="Drummer's Blueprint — Redbubble" required>
        </div>
        <div class="form-field">
          <label>Program</label>
          <input name="program" placeholder="Redbubble" value="Manual">
        </div>
        <div class="form-field">
          <label>Commission</label>
          <input name="commission_rate" placeholder="10%" value="negotiated">
        </div>
        <div class="form-field">
          <label>Type</label>
          <select name="link_type">
            <option value="affiliate">Affiliate</option>
            <option value="partner">Partner</option>
            <option value="recommended">Recommended</option>
            <option value="internal">Internal</option>
          </select>
        </div>
        <div class="form-field">
          <label>Pillar</label>
          <select name="pillar">
            <option value="">— None —</option>
            <option value="Collecting">Collecting</option>
            <option value="Drums">Drums</option>
            <option value="Routines">Routines</option>
            <option value="Hidden Gems">Hidden Gems</option>
            <option value="Operator">Operator</option>
          </select>
        </div>
        <div class="form-field form-grid-wide">
          <label>Target URL *</label>
          <input name="target_url" type="url" placeholder="https://www.redbubble.com/..." required>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-sm">+ Add Link</button>
        <button type="reset" class="btn btn-ghost btn-sm">Clear</button>
      </div>
    </form>
  </div>

  <!-- Links table -->
  <div class="links-card">
    <div class="links-card-header">
      <h2>All Links (<span id="link-count"><%= links.length %></span>)</h2>
      <div class="header-actions">
        <input type="text" id="filter-input" placeholder="Filter by slug, label, pillar…" oninput="filterTable()" style="background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text-primary);font-size:0.82rem;padding:0.4rem 0.75rem;width:220px;">
      </div>
    </div>

    <% if (links.length === 0) { %>
      <div class="empty-state">No affiliate links yet. Add one above.</div>
    <% } else { %>
    <div style="overflow-x:auto;">
      <table class="links-table" id="links-table">
        <thead>
          <tr>
            <th>Slug</th>
            <th>Label</th>
            <th>Pillar</th>
            <th>Type</th>
            <th>Program</th>
            <th>Clicks</th>
            <th>Last Click</th>
            <th>Check</th>
            <th>Active</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="links-tbody">
          <% links.forEach(link => { %>
          <tr data-id="<%= link.id %>" data-search="<%= (link.slug + ' ' + link.label + ' ' + (link.pillar||'') + ' ' + link.program).toLowerCase() %>">
            <td class="slug-cell">
              <a href="/r/<%= link.slug %>" target="_blank" style="color:inherit;text-decoration:none;">/r/<%= link.slug %></a>
            </td>
            <td><%= link.label %></td>
            <td><% if (link.pillar) { %><span class="badge badge-partner" style="opacity:0.8"><%= link.pillar %></span><% } %></td>
            <td><span class="badge badge-<%= link.link_type %>"><%= link.link_type %></span></td>
            <td style="color:var(--text-secondary);font-size:0.8rem"><%= link.program %></td>
            <td class="click-count"><%= link.click_count.toLocaleString() %></td>
            <td style="color:var(--text-secondary);font-size:0.78rem;white-space:nowrap">
              <% if (link.last_clicked_at) { %><%= new Date(link.last_clicked_at).toLocaleDateString() %><% } else { %>—<% } %>
            </td>
            <td class="check-status">
              <% if (!link.last_status) { %>
                <span style="color:var(--text-secondary)">—</span>
              <% } else if (link.last_status < 400) { %>
                <span class="check-ok"><%= link.last_status %> ✓</span>
              <% } else { %>
                <span class="check-fail"><%= link.last_status %> ✗</span>
              <% } %>
            </td>
            <td>
              <span class="status-dot <%= link.is_active ? 'status-active' : 'status-inactive' %>"></span>
            </td>
            <td>
              <div style="display:flex;gap:0.35rem;flex-wrap:wrap;">
                <button class="btn btn-ghost btn-sm" onclick="startEdit(<%= link.id %>)">Edit</button>
                <% if (!link.is_active) { %>
                  <button class="btn btn-ghost btn-sm check-ok" onclick="reactivate(<%= link.id %>)">Reactivate</button>
                <% } %>
                <button class="btn btn-ghost btn-sm" style="color:#aaa" onclick="resetClicks(<%= link.id %>)">Reset</button>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<div id="toast"></div>

<!-- Edit modal (inline row overlay) -->
<div id="edit-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:100;align-items:center;justify-content:center;">
  <div style="background:var(--surface);border:1px solid var(--accent,#d4af37);border-radius:12px;padding:1.75rem;width:min(600px,95vw);max-height:90vh;overflow-y:auto;">
    <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:900;margin:0 0 1.25rem;color:var(--text-primary);">Edit Link</h2>
    <input type="hidden" id="edit-id">
    <div class="form-grid">
      <div class="form-field">
        <label>Label</label>
        <input id="edit-label">
      </div>
      <div class="form-field">
        <label>Program</label>
        <input id="edit-program">
      </div>
      <div class="form-field">
        <label>Commission</label>
        <input id="edit-commission">
      </div>
      <div class="form-field">
        <label>Type</label>
        <select id="edit-type">
          <option value="affiliate">Affiliate</option>
          <option value="partner">Partner</option>
          <option value="recommended">Recommended</option>
          <option value="internal">Internal</option>
        </select>
      </div>
      <div class="form-field">
        <label>Pillar</label>
        <select id="edit-pillar">
          <option value="">— None —</option>
          <option value="Collecting">Collecting</option>
          <option value="Drums">Drums</option>
          <option value="Routines">Routines</option>
          <option value="Hidden Gems">Hidden Gems</option>
          <option value="Operator">Operator</option>
        </select>
      </div>
      <div class="form-field">
        <label>Active</label>
        <select id="edit-active">
          <option value="true">Active</option>
          <option value="false">Inactive</option>
        </select>
      </div>
      <div class="form-field form-grid-wide">
        <label>Target URL</label>
        <input id="edit-url" type="url">
      </div>
    </div>
    <div class="form-actions" style="margin-top:1.25rem;">
      <button class="btn btn-primary btn-sm" onclick="saveEdit()">Save Changes</button>
      <button class="btn btn-ghost btn-sm" onclick="closeEdit()">Cancel</button>
    </div>
  </div>
</div>

<script>
// ── Client state ──────────────────────────────────────────────────────────────
const LINKS = <%- JSON.stringify(links) %>;
let linkMap = {};
LINKS.forEach(l => linkMap[l.id] = l);

function toast(msg, dur = 2500) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), dur);
}

// ── Filter ────────────────────────────────────────────────────────────────────
function filterTable() {
  const q = document.getElementById('filter-input').value.toLowerCase();
  let count = 0;
  document.querySelectorAll('#links-tbody tr').forEach(row => {
    const match = !q || row.dataset.search.includes(q);
    row.style.display = match ? '' : 'none';
    if (match) count++;
  });
  document.getElementById('link-count').textContent = q ? count : LINKS.length;
}

// ── Add form ──────────────────────────────────────────────────────────────────
async function submitAddForm(e) {
  e.preventDefault();
  const fd = new FormData(e.target);
  const body = Object.fromEntries(fd.entries());
  try {
    const r = await fetch('/api/affiliate/links', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await r.json();
    if (!data.ok) { toast('Error: ' + data.error); return; }
    toast('Link added — reloading…');
    setTimeout(() => location.reload(), 800);
  } catch (err) {
    toast('Network error');
  }
}

// ── Edit modal ────────────────────────────────────────────────────────────────
function startEdit(id) {
  const l = linkMap[id];
  if (!l) return;
  document.getElementById('edit-id').value = id;
  document.getElementById('edit-label').value = l.label;
  document.getElementById('edit-program').value = l.program;
  document.getElementById('edit-commission').value = l.commission_rate;
  document.getElementById('edit-type').value = l.link_type;
  document.getElementById('edit-pillar').value = l.pillar || '';
  document.getElementById('edit-active').value = String(l.is_active);
  document.getElementById('edit-url').value = l.target_url;
  document.getElementById('edit-modal').style.display = 'flex';
}

function closeEdit() {
  document.getElementById('edit-modal').style.display = 'none';
}

async function saveEdit() {
  const id = document.getElementById('edit-id').value;
  const body = {
    label:           document.getElementById('edit-label').value,
    program:         document.getElementById('edit-program').value,
    commission_rate: document.getElementById('edit-commission').value,
    link_type:       document.getElementById('edit-type').value,
    pillar:          document.getElementById('edit-pillar').value || null,
    is_active:       document.getElementById('edit-active').value === 'true',
    target_url:      document.getElementById('edit-url').value,
  };
  try {
    const r = await fetch('/api/affiliate/links/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await r.json();
    if (!data.ok) { toast('Error: ' + data.error); return; }
    toast('Saved — reloading…');
    closeEdit();
    setTimeout(() => location.reload(), 600);
  } catch (err) { toast('Network error'); }
}

// ── Reset clicks ──────────────────────────────────────────────────────────────
async function resetClicks(id) {
  if (!confirm('Reset click count to 0?')) return;
  try {
    const r = await fetch('/api/affiliate/links/' + id + '/reset-clicks', { method: 'POST' });
    const data = await r.json();
    if (data.ok) { toast('Clicks reset'); setTimeout(() => location.reload(), 600); }
  } catch (err) { toast('Network error'); }
}

// ── Reactivate ────────────────────────────────────────────────────────────────
async function reactivate(id) {
  try {
    const r = await fetch('/api/affiliate/links/' + id + '/reactivate', { method: 'POST' });
    const data = await r.json();
    if (data.ok) { toast('Link reactivated'); setTimeout(() => location.reload(), 600); }
  } catch (err) { toast('Network error'); }
}

// ── Broken link checker ───────────────────────────────────────────────────────
async function checkAllLinks() {
  const btn = document.getElementById('check-btn');
  btn.disabled = true;
  btn.textContent = '⏳ Checking…';
  try {
    const r = await fetch('/api/admin/check-links');
    const data = await r.json();
    if (!data.ok) { toast('Check failed'); return; }
    const broken = data.results.filter(r => r.broken);
    toast(broken.length === 0
      ? `✓ All ${data.checked} links OK`
      : `⚠ ${broken.length} broken: ${broken.map(b => b.slug).join(', ')}`
      , 5000);
    setTimeout(() => location.reload(), 1000);
  } catch (err) {
    toast('Check failed: network error');
  } finally {
    btn.disabled = false;
    btn.textContent = '🔍 Check All Links';
  }
}

// ── CSV Export ────────────────────────────────────────────────────────────────
function exportCSV() {
  const cols = ['id','slug','label','program','link_type','pillar','target_url','commission_rate','click_count','last_clicked_at','is_active','last_status'];
  const rows = LINKS.map(l => cols.map(c => JSON.stringify(l[c] ?? '')).join(','));
  const csv = [cols.join(','), ...rows].join('\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
  a.download = 'stickvault_affiliate_links.csv';
  a.click();
}

// Close modal on backdrop click
document.getElementById('edit-modal').addEventListener('click', function(e) {
  if (e.target === this) closeEdit();
});
</script>

<%- include('../partials/footer') %>
