<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= typeof title !== 'undefined' ? title : 'StickVault — Sports Cards, Drums & Collector Lifestyle' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Deep dives on sports card collecting, grading, drums, side hustles, and routines. The vault for serious collectors and creators.' %>">

  <!-- Crawl control: admin pages opt out of indexing -->
  <% if (typeof noindex !== 'undefined' && noindex) { %>
  <meta name="robots" content="noindex,nofollow">
  <% } %>

  <!-- Google Search Console domain verification — set GSC_VERIFICATION_TOKEN env var -->
  <% if (typeof gscVerificationToken !== 'undefined' && gscVerificationToken) { %>
  <meta name="google-site-verification" content="<%= gscVerificationToken %>">
  <% } %>

  <!-- Pinterest domain verification — set PINTEREST_VERIFICATION_TOKEN env var -->
  <% if (typeof pinterestVerificationToken !== 'undefined' && pinterestVerificationToken) { %>
  <meta name="pinterest-domain-verification" content="<%= pinterestVerificationToken %>">
  <% } %>

  <!-- Canonical URL -->
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : siteUrl + (typeof canonicalPath !== 'undefined' ? canonicalPath : '') %>">

  <!-- Open Graph / Pinterest -->
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <meta property="og:site_name" content="StickVault">
  <meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : siteUrl + (typeof canonicalPath !== 'undefined' ? canonicalPath : '') %>">
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : (typeof title !== 'undefined' ? title : 'StickVault — Sports Cards, Drums & Collector Lifestyle') %>">
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Deep dives on sports card collecting, grading, drums, side hustles, and routines. The vault for serious collectors and creators.' %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : siteUrl + '/img/og-default.jpg' %>">
  <!-- Pinterest prefers 2:3 vertical pins (1000x1500 ideal). Width/height tags hint the ratio. -->
  <meta property="og:image:width" content="<%= typeof ogImageWidth !== 'undefined' ? ogImageWidth : '1000' %>">
  <meta property="og:image:height" content="<%= typeof ogImageHeight !== 'undefined' ? ogImageHeight : '1500' %>">
  <!-- Rich Pin validation marker -->
  <meta name="pinterest-rich-pin" content="true">
  <% if (typeof pinterestDescription !== 'undefined') { %>
  <meta name="pinterest:description" content="<%= pinterestDescription %>">
  <meta property="pin:description" content="<%= pinterestDescription %>">
  <% } %>
  <% if (typeof ogImage !== 'undefined' && ogImage) { %>
  <meta property="pin:media" content="<%= ogImage %>">
  <% } %>
  <!-- Article-specific OG tags — only emitted on blog posts (ogType=article) -->
  <% if (typeof ogType !== 'undefined' && ogType === 'article') { %>
  <meta property="article:author" content="StickVault">
  <% if (typeof articlePublishedTime !== 'undefined' && articlePublishedTime) { %>
  <meta property="article:published_time" content="<%= articlePublishedTime %>">
  <% } %>
  <% if (typeof articleModifiedTime !== 'undefined' && articleModifiedTime) { %>
  <meta property="article:modified_time" content="<%= articleModifiedTime %>">
  <% } %>
  <% if (typeof articleSection !== 'undefined' && articleSection) { %>
  <meta property="article:section" content="<%= articleSection %>">
  <% } %>
  <% } %>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'StickVault' %>">
  <meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : siteUrl + '/img/og-default.jpg' %>">

  <!-- Schema.org structured data -->
  <% if (typeof schemaOrg !== 'undefined') { %>
  <script type="application/ld+json"><%- schemaOrg %></script>
  <% } %>
  <% if (typeof breadcrumbSchema !== 'undefined') { %>
  <script type="application/ld+json"><%- breadcrumbSchema %></script>
  <% } %>

  <!-- Organization schema — always present for brand signals -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "StickVault",
    "url": "<%= siteUrl %>",
    "description": "Deep dives on sports card collecting, grading, drums, side hustles, and routines. The vault for serious collectors and creators.",
    "sameAs": []
  }
  </script>

  <!-- SiteNavigationElement schema (L1) — signals primary nav structure to Google -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SiteLinksSearchBox",
    "url": "<%= siteUrl %>",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "<%= siteUrl %>/blog?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "StickVault Navigation",
    "itemListElement": [
      {"@type":"SiteNavigationElement","position":1,"name":"The Vault Blog","url":"<%= siteUrl %>/blog"},
      {"@type":"SiteNavigationElement","position":2,"name":"Drums","url":"<%= siteUrl %>/blog?category=drums"},
      {"@type":"SiteNavigationElement","position":3,"name":"Collecting","url":"<%= siteUrl %>/blog?category=collecting"},
      {"@type":"SiteNavigationElement","position":4,"name":"Free Guides","url":"<%= siteUrl %>/free"},
      {"@type":"SiteNavigationElement","position":5,"name":"Shop","url":"<%= siteUrl %>/shop"}
    ]
  }
  </script>

  <!-- Favicon — dark vault aesthetic, gold SV monogram -->
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="alternate icon" href="/favicon.ico" type="image/x-icon">

  <!-- Fonts: Syne (display) + Instrument Serif (body text) + DM Mono (accents/labels) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&family=DM+Mono:ital,wght@0,400;0,500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <%- themeCSS %>
  <!-- In-house analytics tracker — no third-party scripts, full data ownership -->
  <script src="/js/analytics.js" defer></script>

  <!-- Pinterest conversion tracking — enables Pinterest Analytics for pin click conversions -->
  <!-- Shim sets up window.pintrk before core.js loads; pintrk('load', ...) activates the tag -->
  <script>
    !function(e){if(!e.pintrk){e.pintrk=function(){e.pintrk.queue.push(Array.prototype.slice.call(arguments))};var t=e.pintrk.queue=[],r=new Image;r.src="https://ct.pinterest.com/v1/?tid=<%= pinterestTagId ? pinterestTagId : '' %>";t.push=function(e){t.push([e])}}}(window);
    pintrk('load', '<%= pinterestTagId ? pinterestTagId : '' %>');
    pintrk('page');
  </script>
  <script async defer src="https://s.pinimg.com/ct/core.js"></script>

  <!-- GA4 loaded conditionally by cookie-consent partial after explicit user consent (GDPR).
       ga4Id var is available to cookie-consent.ejs for deferred script injection. -->
</head>
<body>
