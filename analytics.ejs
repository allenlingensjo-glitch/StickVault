<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<style>
  .admin-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .admin-header {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
  }
  .admin-header h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 900;
    color: var(--text-primary);
    margin: 0 0 0.4rem;
  }
  .admin-header p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;
  }
  .analytics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  @media (max-width: 700px) { .analytics-grid { grid-template-columns: 1fr; } }
  .analytics-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
  }
  .analytics-card h2 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 1rem;
  }
  .analytics-card.full-width {
    grid-column: 1 / -1;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .data-table th {
    text-align: left;
    padding: 0.4rem 0.6rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--border);
  }
  .data-table td {
    padding: 0.55rem 0.6rem;
    color: var(--text-primary);
    border-bottom: 1px solid rgba(255,255,255,0.04);
    vertical-align: top;
  }
  .data-table tr:last-child td { border-bottom: none; }
  .count-pill {
    display: inline-block;
    background: var(--accent-primary);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
    min-width: 2.5rem;
    text-align: center;
  }
  .count-pill.secondary {
    background: var(--surface-hover, rgba(255,255,255,0.08));
    color: var(--text-secondary);
  }
  .bar-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .bar-track {
    flex: 1;
    height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: 3px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    border-radius: 3px;
    background: var(--cat-routines, #7dd3a8);
    transition: width 0.4s ease;
  }
  .bar-fill.drums  { background: var(--cat-drums, #ff6b6b); }
  .bar-fill.buy    { background: var(--cat-hidden-gems, #f6c90e); }
  .trend-chart {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 80px;
    margin-top: 0.5rem;
  }
  .trend-bar {
    flex: 1;
    background: var(--accent-primary, #7dd3a8);
    border-radius: 2px 2px 0 0;
    min-height: 2px;
    opacity: 0.8;
    position: relative;
    cursor: default;
  }
  .trend-bar:hover { opacity: 1; }
  .trend-labels {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-secondary);
    margin-top: 0.3rem;
  }
  .empty-state {
    color: var(--text-secondary);
    font-size: 0.88rem;
    padding: 0.5rem 0;
    font-style: italic;
  }
  .nav-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .nav-tab {
    padding: 0.3rem 0.8rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
    border: 1px solid var(--border);
    background: none;
    color: var(--text-secondary);
    transition: all 0.15s;
  }
  .nav-tab.active {
    background: var(--accent-primary);
    color: var(--bg);
    border-color: var(--accent-primary);
  }
  .tab-pane { display: none; }
  .tab-pane.active { display: block; }
</style>

<div class="admin-wrap">
  <div class="admin-header">
    <h1>Analytics</h1>
    <p>StickVault · Last 7 and 30 days · Internal use only</p>
  </div>

  <!-- Trend Chart -->
  <div class="analytics-card full-width" style="margin-bottom:1.5rem">
    <h2>Daily Page Views — Last 30 Days</h2>
    <%
      const maxViews = trend.length
        ? Math.max(...trend.map(r => parseInt(r.views, 10))) || 1
        : 1;
    %>
    <% if (trend.length === 0) { %>
      <p class="empty-state">No data yet — views will appear as traffic comes in.</p>
    <% } else { %>
      <div class="trend-chart">
        <% trend.forEach(function(row) { %>
          <%
            const pct = Math.round((parseInt(row.views, 10) / maxViews) * 100);
            const label = new Date(row.day).toLocaleDateString('en-US', { month:'short', day:'numeric' });
          %>
          <div class="trend-bar"
               style="height: <%= pct %>%"
               title="<%= label %>: <%= row.views %> views"></div>
        <% }); %>
      </div>
      <div class="trend-labels">
        <span><%= new Date(trend[0].day).toLocaleDateString('en-US', { month:'short', day:'numeric' }) %></span>
        <span><%= new Date(trend[trend.length-1].day).toLocaleDateString('en-US', { month:'short', day:'numeric' }) %></span>
      </div>
    <% } %>
  </div>

  <div class="analytics-grid">

    <!-- Top Pages -->
    <div class="analytics-card">
      <h2>Top Pages</h2>
      <div class="nav-tabs">
        <button class="nav-tab active" onclick="switchTab(this,'pages7')">7 days</button>
        <button class="nav-tab" onclick="switchTab(this,'pages30')">30 days</button>
      </div>
      <div id="pages7" class="tab-pane active">
        <% if (topPages7.length === 0) { %>
          <p class="empty-state">No page views yet.</p>
        <% } else { %>
          <%
            const max7 = Math.max(...topPages7.map(r => parseInt(r.views,10))) || 1;
          %>
          <table class="data-table">
            <thead><tr><th>Page</th><th>Views</th></tr></thead>
            <tbody>
              <% topPages7.forEach(function(row) { %>
                <tr>
                  <td><%= row.slug || row.title || '—' %></td>
                  <td>
                    <div class="bar-wrap">
                      <div class="bar-track">
                        <div class="bar-fill" style="width:<%= Math.round(parseInt(row.views,10)/max7*100) %>%"></div>
                      </div>
                      <span class="count-pill"><%= row.views %></span>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
      <div id="pages30" class="tab-pane">
        <% if (topPages30.length === 0) { %>
          <p class="empty-state">No page views yet.</p>
        <% } else { %>
          <%
            const max30 = Math.max(...topPages30.map(r => parseInt(r.views,10))) || 1;
          %>
          <table class="data-table">
            <thead><tr><th>Page</th><th>Views</th></tr></thead>
            <tbody>
              <% topPages30.forEach(function(row) { %>
                <tr>
                  <td><%= row.slug || row.title || '—' %></td>
                  <td>
                    <div class="bar-wrap">
                      <div class="bar-track">
                        <div class="bar-fill" style="width:<%= Math.round(parseInt(row.views,10)/max30*100) %>%"></div>
                      </div>
                      <span class="count-pill"><%= row.views %></span>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>

    <!-- Traffic Sources -->
    <div class="analytics-card">
      <h2>Traffic Sources — 30 Days</h2>
      <% if (sources.length === 0) { %>
        <p class="empty-state">No data yet.</p>
      <% } else { %>
        <%
          const maxSrc = Math.max(...sources.map(r => parseInt(r.sessions,10))) || 1;
        %>
        <table class="data-table">
          <thead><tr><th>Source</th><th>Sessions</th></tr></thead>
          <tbody>
            <% sources.forEach(function(row) { %>
              <tr>
                <td><%= row.source %></td>
                <td>
                  <div class="bar-wrap">
                    <div class="bar-track">
                      <div class="bar-fill" style="width:<%= Math.round(parseInt(row.sessions,10)/maxSrc*100) %>%"></div>
                    </div>
                    <span class="count-pill"><%= row.sessions %></span>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- Email Signups -->
    <div class="analytics-card">
      <h2>Email Signups by Source — 30 Days</h2>
      <% if (signups.length === 0) { %>
        <p class="empty-state">No signup events yet.</p>
      <% } else { %>
        <%
          const totalSignups = signups.reduce((acc, r) => acc + parseInt(r.signups,10), 0);
          const maxSig = Math.max(...signups.map(r => parseInt(r.signups,10))) || 1;
        %>
        <p style="font-family:var(--font-mono);font-size:0.8rem;color:var(--text-secondary);margin:0 0 0.8rem">
          Total: <strong style="color:var(--text-primary)"><%= totalSignups %></strong>
        </p>
        <table class="data-table">
          <thead><tr><th>Source</th><th>Signups</th></tr></thead>
          <tbody>
            <% signups.forEach(function(row) { %>
              <tr>
                <td><%= row.source || 'unknown' %></td>
                <td>
                  <div class="bar-wrap">
                    <div class="bar-track">
                      <div class="bar-fill drums" style="width:<%= Math.round(parseInt(row.signups,10)/maxSig*100) %>%"></div>
                    </div>
                    <span class="count-pill secondary"><%= row.signups %></span>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- Product Clicks -->
    <div class="analytics-card">
      <h2>Product Clicks — 30 Days</h2>
      <% if (productClicks.length === 0) { %>
        <p class="empty-state">No product click events yet.</p>
      <% } else { %>
        <%
          const maxClk = Math.max(...productClicks.map(r => parseInt(r.clicks,10))) || 1;
        %>
        <table class="data-table">
          <thead><tr><th>Product</th><th>Type</th><th>Clicks</th></tr></thead>
          <tbody>
            <% productClicks.forEach(function(row) { %>
              <tr>
                <td><%= row.product_title || row.product_slug || '—' %></td>
                <td style="font-family:var(--font-mono);font-size:0.75rem;color:var(--text-secondary)"><%= row.click_type || '—' %></td>
                <td>
                  <div class="bar-wrap">
                    <div class="bar-track">
                      <div class="bar-fill buy" style="width:<%= Math.round(parseInt(row.clicks,10)/maxClk*100) %>%"></div>
                    </div>
                    <span class="count-pill secondary"><%= row.clicks %></span>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

  </div><!-- end analytics-grid -->

  <div style="margin-top:1.5rem;padding:1rem 1.5rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;">
    <p style="font-family:var(--font-mono);font-size:0.78rem;color:var(--text-secondary);margin:0">
      Raw JSON: <a href="/api/analytics/summary" style="color:var(--accent-primary)">/api/analytics/summary</a>
      &nbsp;·&nbsp; Data agent endpoint — same data, machine-readable.
    </p>
  </div>
</div>

<script>
function switchTab(btn, paneId) {
  var card = btn.closest('.analytics-card');
  card.querySelectorAll('.nav-tab').forEach(function(t) { t.classList.remove('active'); });
  card.querySelectorAll('.tab-pane').forEach(function(p) { p.classList.remove('active'); });
  btn.classList.add('active');
  document.getElementById(paneId).classList.add('active');
}
</script>

<%- include('../partials/footer') %>
</body>
</html>
