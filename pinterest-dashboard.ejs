<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<style>
  /* ── Layout ─────────────────────────────────────────────────────────────── */
  .admin-wrap { max-width: 1400px; margin: 0 auto; padding: 1.5rem 1.5rem 5rem; }

  .admin-header {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
  }
  .admin-header h1 { font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: var(--text-primary); margin: 0 0 0.25rem; }
  .admin-header p  { color: var(--text-secondary); font-size: 0.88rem; margin: 0; }

  /* ── Pinterest tracking indicator ──────────────────────────────────────── */
  .tracking-indicator {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(212,175,55,0.08); border: 1px solid rgba(212,175,55,0.25);
    border-radius: 6px; padding: 0.5rem 0.9rem; font-size: 0.78rem; color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .tracking-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #6dbe6d; animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

  /* ── Summary stats ──────────────────────────────────────────────────────── */
  .summary-row { display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .summary-stat {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px;
    padding: 0.9rem 1.4rem; text-align: center; min-width: 90px;
  }
  .summary-stat .num { font-size: 1.8rem; font-weight: 900; color: var(--accent); line-height: 1; margin-bottom: 0.2rem; }
  .summary-stat .lbl { font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .08em; }

  /* ── Filter / sort bar ──────────────────────────────────────────────────── */
  .filter-bar {
    display: flex; gap: 0.75rem; align-items: flex-end; flex-wrap: wrap;
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px;
    padding: 1rem 1.1rem; margin-bottom: 1.5rem;
  }
  .filter-group { display: flex; flex-direction: column; gap: 0.3rem; flex: 1; min-width: 140px; }
  .filter-label {
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: .07em;
    text-transform: uppercase; color: var(--text-muted); font-weight: 600;
  }
  .filter-input, .filter-select {
    background: var(--bg); border: 1px solid var(--border); border-radius: 6px;
    color: var(--text-primary); font-family: var(--font-mono); font-size: 0.8rem;
    padding: 0.45rem 0.75rem; outline: none; width: 100%;
    transition: border-color var(--transition);
  }
  .filter-input:focus, .filter-select:focus { border-color: var(--accent); }
  .filter-select { cursor: pointer; appearance: none; -webkit-appearance: none; }
  .filter-select-wrap { position: relative; }
  .filter-select-wrap::after {
    content: '▼'; position: absolute; right: 0.65rem; top: 50%; transform: translateY(-50%);
    font-size: 0.55rem; color: var(--text-muted); pointer-events: none;
  }
  .filter-bar-right { display: flex; gap: 0.5rem; align-items: flex-end; flex-shrink: 0; }
  .btn-clear {
    font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted);
    background: transparent; border: 1px solid var(--border); border-radius: 6px;
    padding: 0.45rem 0.85rem; cursor: pointer; transition: all .15s; white-space: nowrap;
  }
  .btn-clear:hover { color: var(--text-primary); border-color: var(--border-hover); }

  /* ── Results count ────────────────────────────────────────────────────────── */
  .results-bar {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;
  }
  .results-count { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted); }
  .results-count strong { color: var(--accent); }

  /* ── Section heading ─────────────────────────────────────────────────────── */
  .section-heading {
    display: flex; align-items: center; gap: 0.75rem;
    font-family: var(--font-display); font-size: 1rem; font-weight: 900;
    color: var(--text-primary); margin-bottom: 1rem;
    border-bottom: 1px solid var(--border); padding-bottom: 0.6rem;
  }
  .section-count { font-size: 0.75rem; color: var(--text-muted); font-weight: 400; font-family: var(--font-mono); }

  /* ── Pin grid ───────────────────────────────────────────────────────────── */
  .pin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  /* ── Pin card ───────────────────────────────────────────────────────────── */
  .pin-card {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px;
    overflow: hidden; transition: border-color .2s;
  }
  .pin-card.posted  { border-left: 3px solid #4a9a4a; }
  .pin-card.not-posted { border-left: 3px solid var(--border); }
  .pin-card.updating { opacity: 0.7; }

  /* Hero image row */
  .card-image-row {
    position: relative; height: 180px; overflow: hidden; background: #111;
  }
  .card-hero-img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .card-image-placeholder {
    width: 100%; height: 100%; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 0.5rem; background: #111;
  }
  .card-image-placeholder span { font-size: 0.7rem; color: var(--text-muted); }
  .card-img-badge {
    position: absolute; top: 8px; left: 8px;
    background: rgba(0,0,0,0.7); border-radius: 4px;
    padding: 0.2rem 0.5rem; font-size: 0.65rem; color: #6dbe6d;
    display: flex; align-items: center; gap: 0.3rem;
  }
  .card-img-badge.loading { color: var(--accent); }
  .card-img-badge.missing { color: #be6d6d; }

  /* Card body */
  .card-body { padding: 1rem 1.1rem; }

  /* Card header */
  .card-header { display: flex; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.65rem; flex-wrap: wrap; }
  .card-num { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-muted); flex-shrink: 0; }
  .card-pillar-tag {
    font-size: 0.62rem; font-weight: 700; letter-spacing: .08em;
    padding: 0.15rem 0.45rem; border-radius: 3px;
    background: rgba(212,175,55,0.12); color: var(--accent); text-transform: uppercase;
  }

  /* Status dropdown */
  .status-select-wrap { position: relative; margin-left: auto; }
  .status-select {
    font-family: var(--font-mono); font-size: 0.65rem; font-weight: 600;
    letter-spacing: .04em; text-transform: uppercase; padding: 0.15rem 1.6rem 0.15rem 0.5rem;
    border-radius: 3px; border: 1px solid var(--border); background: var(--bg);
    color: var(--text-primary); cursor: pointer; appearance: none; -webkit-appearance: none;
    transition: border-color .15s;
  }
  .status-select:focus { outline: none; border-color: var(--accent); }
  .status-select-wrap::after {
    content: '▼'; position: absolute; right: 0.4rem; top: 50%; transform: translateY(-50%);
    font-size: 0.5rem; color: var(--text-muted); pointer-events: none;
  }
  .status-select.posted  { background: #1a3a1a; color: #6dbe6d; border-color: rgba(74,154,74,.4); }
  .status-select.not-posted { background: #1a1a2a; color: #6d8dbe; border-color: rgba(107,141,190,.3); }

  /* Blog post title */
  .blog-post-title {
    font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.4rem;
    display: flex; align-items: center; gap: 0.4rem;
  }
  .blog-post-title svg { flex-shrink: 0; opacity: 0.5; }

  /* Pin headline */
  .pin-headline {
    font-size: 0.88rem; font-weight: 700; color: var(--text-primary);
    line-height: 1.4; margin-bottom: 0.5rem;
  }

  /* Pin description */
  .pin-description {
    font-size: 0.76rem; color: var(--text-secondary); line-height: 1.5;
    margin-bottom: 0.65rem;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* Meta pills */
  .meta-pills { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .meta-pill {
    font-size: 0.67rem; padding: 0.2rem 0.55rem; border-radius: 20px;
    border: 1px solid var(--border); color: var(--text-secondary);
  }
  .meta-pill.board { border-color: rgba(212,175,55,.3); color: var(--accent); }
  .meta-pill.cta   { border-color: rgba(100,150,255,.3); color: #7aaeee; }
  .meta-pill.affiliate {
    border-color: rgba(74,154,74,.4); color: #6dbe6d;
    background: rgba(74,154,74,.08);
  }
  .meta-pill.no-affiliate {
    border-color: var(--border); color: var(--text-muted);
  }

  /* Editable fields section */
  .editable-fields {
    border-top: 1px solid var(--border); padding-top: 0.75rem; margin-top: 0.5rem;
  }
  .editable-row {
    display: flex; gap: 0.5rem; margin-bottom: 0.5rem; align-items: flex-start; flex-wrap: wrap;
  }
  .editable-field { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; min-width: 110px; }
  .editable-label {
    font-family: var(--font-mono); font-size: 0.58rem; text-transform: uppercase;
    letter-spacing: .07em; color: var(--text-muted); font-weight: 600;
  }
  .editable-input, .editable-textarea {
    background: var(--bg); border: 1px solid var(--border); border-radius: 5px;
    color: var(--text-primary); font-family: var(--font-mono); font-size: 0.72rem;
    padding: 0.3rem 0.5rem; outline: none; transition: border-color .15s; width: 100%;
  }
  .editable-input:focus, .editable-textarea:focus { border-color: var(--accent); }
  .editable-textarea { resize: vertical; min-height: 40px; line-height: 1.4; }
  .editable-input[type="date"] { cursor: pointer; }
  .save-flash {
    font-family: var(--font-mono); font-size: 0.62rem; color: #6dbe6d;
    opacity: 0; transition: opacity .2s; margin-left: 0.5rem; align-self: center;
    white-space: nowrap;
  }
  .save-flash.visible { opacity: 1; }

  /* URL fields */
  .url-field { margin-bottom: 0.4rem; }
  .url-label {
    font-size: 0.62rem; text-transform: uppercase; letter-spacing: .07em;
    color: var(--text-muted); font-weight: 600; margin-bottom: 0.15rem;
  }
  .url-value-row { display: flex; align-items: flex-start; gap: 0.4rem; }
  .url-value {
    font-size: 0.72rem; color: var(--text-secondary); line-height: 1.4;
    flex: 1; word-break: break-all;
  }
  .url-value a { color: var(--accent); text-decoration: none; }
  .url-value a:hover { text-decoration: underline; }

  /* Copy button */
  .copy-btn {
    flex-shrink: 0; background: transparent; border: 1px solid var(--border);
    color: var(--text-muted); cursor: pointer; border-radius: 4px;
    padding: 0.15rem 0.45rem; font-size: 0.67rem; transition: all .15s;
    margin-top: 0.05rem; min-height: 26px; min-width: 38px;
  }
  .copy-btn:hover { border-color: var(--accent); color: var(--accent); }
  .copy-btn.copied { border-color: #4a9a4a; color: #6dbe6d; }
  .copy-btn .copy-label { display: inline; }
  .copy-btn .copied-label { display: none; }
  .copy-btn.is-copied .copy-label { display: none; }
  .copy-btn.is-copied .copied-label { display: inline; }

  /* Card actions */
  .card-actions {
    display: flex; gap: 0.5rem; flex-wrap: wrap;
    border-top: 1px solid var(--border); padding-top: 0.75rem; margin-top: 0.5rem;
  }
  .btn {
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.4rem 0.8rem; border-radius: 5px; font-weight: 700; font-size: 0.75rem;
    cursor: pointer; white-space: nowrap; border: none; text-decoration: none; flex: 1; justify-content: center;
    transition: opacity .15s; min-height: 34px;
  }
  .btn:hover { opacity: .82; }
  .btn-gold  { background: var(--accent); color: #000; }
  .btn-ghost { background: transparent; color: var(--accent); border: 1px solid rgba(212,175,55,.4); }
  .btn-dark  { background: var(--bg-card); color: var(--text-secondary); border: 1px solid var(--border); }

  /* Empty state */
  .empty-results {
    text-align: center; padding: 4rem 2rem; color: var(--text-muted);
    font-family: var(--font-mono); font-size: 0.85rem;
  }
  .empty-results span { display: block; margin-bottom: 0.5rem; opacity: 0.4; font-size: 2rem; }

  /* Hidden (filtered out) */
  .pin-card[data-hidden="true"] { display: none; }

  /* ── Responsive ──────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .filter-bar { flex-direction: column; gap: 0.6rem; }
    .filter-group { min-width: 100%; }
    .filter-bar-right { width: 100%; }
    .btn-clear { flex: 1; text-align: center; }
  }
  @media (max-width: 600px) {
    .pin-grid { grid-template-columns: 1fr; }
    .card-image-row { height: 140px; }
    .admin-wrap { padding: 1rem; }
  }
</style>

<div class="admin-wrap">

  <!-- ── Header ──────────────────────────────────────────────────────────────── -->
  <div class="admin-header">
    <div>
      <h1>Pinterest Posting Dashboard</h1>
      <p>Manage, update, and track all 30 pins — search, filter, sort, and save inline.</p>
    </div>
    <div style="display:flex;gap:0.6rem;flex-wrap:wrap;flex-shrink:0;align-items:center;">
      <a href="/admin/pinterest-pins" class="btn btn-dark" style="flex:none;">⚙ Pin Generator</a>
      <a href="/admin/pinterest-posting-guide" class="btn btn-ghost" style="flex:none;">📋 Posting Guide</a>
    </div>
  </div>

  <!-- ── Pinterest tracking status ──────────────────────────────────────────── -->
  <div class="tracking-indicator">
    <span class="tracking-dot"></span>
    <span>Pinterest Tag Active: <strong><%= pinterestTagId %></strong></span>
  </div>

  <!-- ── Summary stats ──────────────────────────────────────────────────────── -->
  <div class="summary-row">
    <div class="summary-stat"><div class="num" id="stat-total"><%= summary.total %></div><div class="lbl">Total Pins</div></div>
    <div class="summary-stat"><div class="num" id="stat-posted"><%= summary.posted %></div><div class="lbl">Posted</div></div>
    <div class="summary-stat"><div class="num" id="stat-not-posted"><%= summary.not_posted %></div><div class="lbl">Not Posted</div></div>
  </div>

  <!-- ── Filter / sort bar ──────────────────────────────────────────────────── -->
  <div class="filter-bar">
    <div class="filter-group" style="flex: 2; min-width: 200px;">
      <label class="filter-label" for="search-input">Search</label>
      <input id="search-input" class="filter-input" type="text" placeholder="Pin title, blog post, description…">
    </div>
    <div class="filter-group">
      <label class="filter-label" for="status-filter">Status</label>
      <div class="filter-select-wrap">
        <select id="status-filter" class="filter-select">
          <option value="">All</option>
          <option value="not_posted">Not Posted</option>
          <option value="posted">Posted</option>
        </select>
      </div>
    </div>
    <div class="filter-group">
      <label class="filter-label" for="category-filter">Category</label>
      <div class="filter-select-wrap">
        <select id="category-filter" class="filter-select">
          <option value="">All</option>
          <option value="collecting">Collecting</option>
          <option value="drums">Drums</option>
          <option value="routines">Routines</option>
          <option value="hidden-gems">Hidden Gems</option>
          <option value="side-hustles">Operator</option>
        </select>
      </div>
    </div>
    <div class="filter-group">
      <label class="filter-label" for="sort-select">Sort By</label>
      <div class="filter-select-wrap">
        <select id="sort-select" class="filter-select">
          <option value="pin_number">Pin #</option>
          <option value="title">Pin Title</option>
          <option value="category">Blog Category</option>
          <option value="status">Posting Status</option>
          <option value="scheduled_date">Scheduled Date</option>
        </select>
      </div>
    </div>
    <div class="filter-group" style="flex: 0 0 auto;">
      <label class="filter-label" for="sort-dir">&nbsp;</label>
      <div class="filter-select-wrap">
        <select id="sort-dir" class="filter-select">
          <option value="asc">↑ Asc</option>
          <option value="desc">↓ Desc</option>
        </select>
      </div>
    </div>
    <div class="filter-bar-right">
      <button class="btn-clear" onclick="clearFilters()">Clear</button>
    </div>
  </div>

  <!-- ── Results count ──────────────────────────────────────────────────────── -->
  <div class="results-bar">
    <div class="results-count">Showing <strong id="visible-count"><%= pins.length %></strong> of <%= pins.length %> pins</div>
  </div>

  <%
  const PILLAR_ORDER = ['COLLECTING','DRUMS','ROUTINES','DISCOVERY','OPERATOR'];
  const PILLAR_LABELS = { COLLECTING: 'Collecting', DRUMS: 'Drums', ROUTINES: 'Routines', DISCOVERY: 'Hidden Gems', OPERATOR: 'Operator' };
  const PILLAR_CATEGORY_MAP = { COLLECTING: 'collecting', DRUMS: 'drums', ROUTINES: 'routines', DISCOVERY: 'hidden-gems', OPERATOR: 'side-hustles' };

  function pad(n) { return String(n).padStart(2,'0'); }
  function safe(v) { return ((v || '')+'').replace(/'/g, '&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function makeHeroUrl(slug) { return siteUrl + '/pins/' + (slug||'') + '.png'; }
  function makeBlogUrl(slug) { return siteUrl + '/blog/' + (slug||''); }

  function getHashtags(keywords) {
    if (!keywords) return '';
    return keywords.split(',').map(k => '#'+k.trim().replace(/\b\bt\b/gi,'').replace(/[^a-z0-9 ]/gi,'').trim().split(' ')[0]).filter((h,i,a) => h.length > 1 && a.indexOf(h) === i).slice(0,5).join(' ');
  }

  function formatDate(val) {
    if (!val) return '';
    const d = new Date(val);
    if (isNaN(d)) return '';
    return d.toISOString().split('T')[0];
  }
  %>

  <!-- ── Pin grid (all 30 cards, filtered client-side) ──────────────────── -->
  <div id="pin-grid" class="pin-grid">
    <% pins.forEach(pin => { %>
    <%
      const pinNum    = pad(pin.pin_number);
      const blogUrl   = makeBlogUrl(pin.blog_slug);
      const heroUrl   = makeHeroUrl(pin.blog_slug);
      const isPosted  = pin.posting_status === 'Posted';
      const hashtags  = getHashtags(pin.keywords);
      const pillarCat = PILLAR_CATEGORY_MAP[pin.pillar] || '';
    %>
    <div class="pin-card <%= isPosted ? 'posted' : 'not-posted' %>"
         id="card-<%= pin.pin_number %>"
         data-search="<%= safe(pin.headline + ' ' + (pin.blog_title||'') + ' ' + (pin.description||'') + ' ' + (pin.board||'') + ' ' + (pin.cta_angle||'')) %>"
         data-status="<%= isPosted ? 'posted' : 'not_posted' %>"
         data-category="<%= pillarCat %>"
         data-pillar="<%= pin.pillar %>"
         data-scheduled="<%= formatDate(pin.scheduled_date) %>"
         data-title="<%= safe(pin.headline) %>"
         data-pin-num="<%= pin.pin_number %>">

      <!-- Hero image row -->
      <div class="card-image-row">
        <% if (pin.blog_slug) { %>
          <img class="card-hero-img"
               src="<%= heroUrl %>"
               alt="Pin image for <%= safe(pin.blog_slug) %>"
               loading="lazy"
               onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
          >
          <div class="card-image-placeholder" style="display:none;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <path d="M21 15l-5-5L5 21"/>
            </svg>
            <span>Image not found</span>
          </div>
          <div class="card-img-badge">
            <svg width="9" height="9" viewBox="0 0 12 12" fill="#6dbe6d"><circle cx="6" cy="6" r="6"/></svg>
            ✅ Live
          </div>
        <% } else { %>
          <div class="card-image-placeholder">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <path d="M21 15l-5-5L5 21"/>
            </svg>
            <span>No blog slug</span>
          </div>
          <div class="card-img-badge missing">📌 No Image</div>
        <% } %>
      </div>

      <!-- Card body -->
      <div class="card-body">

        <!-- Header row -->
        <div class="card-header">
          <span class="card-num">PIN-<%= pinNum %></span>
          <span class="card-pillar-tag"><%= PILLAR_LABELS[pin.pillar] || pin.pillar %></span>
          <div class="status-select-wrap">
            <select class="status-select <%= isPosted ? 'posted' : 'not-posted' %>"
                    id="status-<%= pin.pin_number %>"
                    onchange="updateStatus(<%= pin.pin_number %>, this.value)">
              <option value="Not Posted" <%= !isPosted ? 'selected' : '' %>>⬜ Not Posted</option>
              <option value="Posted" <%= isPosted ? 'selected' : '' %>>✅ Posted</option>
            </select>
          </div>
        </div>

        <!-- Blog post title -->
        <% if (pin.blog_title) { %>
        <div class="blog-post-title">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <%= safe(pin.blog_title).substring(0, 80) %><%= (pin.blog_title||'').length > 80 ? '…' : '' %>
        </div>
        <% } %>

        <!-- Pin headline -->
        <div class="pin-headline"><%= safe(pin.headline) %></div>

        <!-- Pin description -->
        <% if (pin.description) { %>
        <div class="pin-description"><%= safe(pin.description) %></div>
        <% } %>

        <!-- Meta pills: board, CTA, affiliate -->
        <div class="meta-pills">
          <% if (pin.board) { %><span class="meta-pill board">📌 <%= safe(pin.board) %></span><% } %>
          <% if (pin.cta_angle) { %><span class="meta-pill cta">→ <%= safe(pin.cta_angle) %></span><% } %>
          <% if (pin.has_affiliate_link) { %>
            <span class="meta-pill affiliate">✅ Affiliate</span>
          <% } else { %>
            <span class="meta-pill no-affiliate">No Affiliate</span>
          <% } %>
        </div>

        <!-- Editable fields -->
        <div class="editable-fields">
          <div class="editable-row">
            <div class="editable-field" style="flex: 2;">
              <label class="editable-label">Notes</label>
              <textarea class="editable-textarea"
                        id="notes-<%= pin.pin_number %>"
                        placeholder="Internal notes…"
                        onblur="saveField(<%= pin.pin_number %>, 'notes', this.value)"
                        rows="2"><%= safe(pin.notes || '') %></textarea>
            </div>
          </div>
          <div class="editable-row">
            <div class="editable-field">
              <label class="editable-label" for="scheduled-<%= pin.pin_number %>">Scheduled</label>
              <input type="date" class="editable-input"
                     id="scheduled-<%= pin.pin_number %>"
                     value="<%= formatDate(pin.scheduled_date) %>"
                     onchange="saveField(<%= pin.pin_number %>, 'scheduled_date', this.value)">
            </div>
            <div class="editable-field">
              <label class="editable-label" for="published-<%= pin.pin_number %>">Published</label>
              <input type="date" class="editable-input"
                     id="published-<%= pin.pin_number %>"
                     value="<%= formatDate(pin.published_date) %>"
                     onchange="saveField(<%= pin.pin_number %>, 'published_date', this.value)">
            </div>
          </div>
        </div>

        <!-- Live image URL -->
        <% if (pin.blog_slug) { %>
        <div class="url-field">
          <div class="url-label">Live Image URL</div>
          <div class="url-value-row">
            <div class="url-value"><%= heroUrl %></div>
            <button class="copy-btn" onclick="copyText(this, '<%= heroUrl.replace(/'/g, "\\'") %>')">
              <span class="copy-label">Copy</span>
              <span class="copied-label">✓</span>
            </button>
          </div>
        </div>
        <% } %>

        <!-- Live blog URL -->
        <% if (pin.blog_slug) { %>
        <div class="url-field">
          <div class="url-label">Live Blog URL</div>
          <div class="url-value-row">
            <div class="url-value"><a href="<%= blogUrl %>" target="_blank" rel="noopener"><%= blogUrl %></a></div>
            <button class="copy-btn" onclick="copyText(this, '<%= blogUrl.replace(/'/g, "\\'") %>')">
              <span class="copy-label">Copy</span>
              <span class="copied-label">✓</span>
            </button>
          </div>
        </div>
        <% } %>

        <!-- UTM URL -->
        <% if (pin.utm_url) { %>
        <div class="url-field">
          <div class="url-label">UTM URL</div>
          <div class="url-value-row">
            <div class="url-value" style="font-size:0.68rem;"><%= pin.utm_url %></div>
            <button class="copy-btn" onclick="copyText(this, '<%= (pin.utm_url||'').replace(/'/g, "\\'") %>')">
              <span class="copy-label">Copy</span>
              <span class="copied-label">✓</span>
            </button>
          </div>
        </div>
        <% } %>

        <!-- Hashtags -->
        <% if (hashtags) { %>
        <div class="url-field">
          <div class="url-label">Hashtags</div>
          <div class="url-value" style="font-size:0.72rem; color:var(--accent);"><%= hashtags %></div>
        </div>
        <% } %>

        <!-- Card actions -->
        <div class="card-actions">
          <button class="btn btn-ghost" onclick="copyText(this, '<%= (pin.headline||'').replace(/'/g, "\\'") %>')">
            <span class="copy-label">📋 Copy Title</span>
            <span class="copied-label">✓ Copied</span>
          </button>
          <button class="btn btn-ghost" onclick="copyText(this, '<%= (pin.description||'').replace(/'/g, "\\'") %>')">
            <span class="copy-label">📝 Copy Description</span>
            <span class="copied-label">✓ Copied</span>
          </button>
          <% if (pin.blog_slug) { %>
            <a class="btn btn-gold" href="<%= blogUrl %>" target="_blank" rel="noopener" title="Open on www.stickvault.com">🔗 Open Post ↗</a>
          <% } %>
        </div>

      </div><!-- /card-body -->
    </div><!-- /pin-card -->
    <% }) %>
  </div><!-- /pin-grid -->

  <!-- Empty state -->
  <div id="empty-state" class="empty-results" style="display:none;">
    <span>🔍</span>
    No pins match your search. Try different keywords or clear filters.
  </div>

</div><!-- /admin-wrap -->

<script>
/* ────────────────────────────────────────────────────────────────────────────
   SEARCH / FILTER / SORT
   ──────────────────────────────────────────────────────────────────────────── */
const searchInput    = document.getElementById('search-input');
const statusFilter   = document.getElementById('status-filter');
const categoryFilter = document.getElementById('category-filter');
const sortSelect     = document.getElementById('sort-select');
const sortDirSelect  = document.getElementById('sort-dir');
const visibleCountEl = document.getElementById('visible-count');
const emptyState     = document.getElementById('empty-state');
const pinGrid        = document.getElementById('pin-grid');

function applyFilters() {
  const q      = (searchInput.value || '').toLowerCase().trim();
  const status = statusFilter.value;
  const cat    = categoryFilter.value;
  const sort   = sortSelect.value;
  const dir    = sortDirSelect.value === 'desc' ? -1 : 1;

  const cards = Array.from(pinGrid.querySelectorAll('.pin-card'));
  let visible = 0;

  cards.forEach(card => {
    const searchText  = (card.dataset.search || '').toLowerCase();
    const cardStatus  = card.dataset.status || '';
    const cardCategory = card.dataset.category || '';
    const pinned = q === '' || searchText.includes(q);
    const statusOk = status === '' || cardStatus === status;
    const catOk    = cat === '' || cardCategory === cat;

    card.dataset.hidden = (pinned && statusOk && catOk) ? 'false' : 'true';
    if (!card.dataset.hidden || card.dataset.hidden === 'false') visible++;
  });

  // Sort visible cards
  const visibleCards = cards.filter(c => c.dataset.hidden === 'false');
  visibleCards.sort((a, b) => {
    let aVal = '', bVal = '';
    if (sort === 'title') {
      aVal = (a.dataset.title || '').toLowerCase();
      bVal = (b.dataset.title || '').toLowerCase();
    } else if (sort === 'status') {
      aVal = a.dataset.status || '';
      bVal = b.dataset.status || '';
    } else if (sort === 'category') {
      aVal = a.dataset.pillar || '';
      bVal = b.dataset.pillar || '';
    } else if (sort === 'scheduled_date') {
      aVal = a.dataset.scheduled || '';
      bVal = b.dataset.scheduled || '';
    } else {
      aVal = parseInt(a.dataset.pinNum || '0', 10);
      bVal = parseInt(b.dataset.pinNum || '0', 10);
    }
    if (aVal < bVal) return -1 * dir;
    if (aVal > bVal) return 1 * dir;
    return 0;
  });

  // Re-append in sorted order
  visibleCards.forEach(c => pinGrid.appendChild(c));

  visibleCountEl.textContent = visible;
  emptyState.style.display = visible === 0 ? 'block' : 'none';
}

searchInput.addEventListener('input', applyFilters);
statusFilter.addEventListener('change', applyFilters);
categoryFilter.addEventListener('change', applyFilters);
sortSelect.addEventListener('change', applyFilters);
sortDirSelect.addEventListener('change', applyFilters);

function clearFilters() {
  searchInput.value = '';
  statusFilter.value = '';
  categoryFilter.value = '';
  sortSelect.value = 'pin_number';
  sortDirSelect.value = 'asc';
  applyFilters();
}

// Update summary stats from current filter state
function updateSummaryStats() {
  const all = Array.from(pinGrid.querySelectorAll('.pin-card'));
  const visible = all.filter(c => c.dataset.hidden === 'false');
  const posted = visible.filter(c => c.dataset.status === 'posted').length;
  document.getElementById('stat-posted').textContent = posted;
  document.getElementById('stat-not-posted').textContent = visible.length - posted;
}

const origApplyFilters = applyFilters;
function applyFiltersWithStats() {
  origApplyFilters();
  updateSummaryStats();
}

searchInput.removeEventListener('input', applyFilters);
statusFilter.removeEventListener('change', applyFilters);
categoryFilter.removeEventListener('change', applyFilters);
sortSelect.removeEventListener('change', applyFilters);
sortDirSelect.removeEventListener('change', applyFilters);

searchInput.addEventListener('input', applyFiltersWithStats);
statusFilter.addEventListener('change', applyFiltersWithStats);
categoryFilter.addEventListener('change', applyFiltersWithStats);
sortSelect.addEventListener('change', applyFiltersWithStats);
sortDirSelect.addEventListener('change', applyFiltersWithStats);

/* ────────────────────────────────────────────────────────────────────────────
   STATUS UPDATE (PATCH on change)
   ──────────────────────────────────────────────────────────────────────────── */
async function updateStatus(pinNumber, newStatus) {
  const card = document.getElementById('card-' + pinNumber);
  if (!card) return;

  card.classList.add('updating');
  const select = document.getElementById('status-' + pinNumber);

  try {
    const res = await fetch('/api/admin/pinterest-pins/' + pinNumber, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ posting_status: newStatus }),
    });

    const data = await res.json();

    if (res.ok && data.ok) {
      // Update card class
      card.classList.remove('posted', 'not-posted');
      card.classList.add(newStatus === 'Posted' ? 'posted' : 'not-posted');

      // Update dropdown appearance
      select.classList.remove('posted', 'not-posted');
      select.classList.add(newStatus === 'Posted' ? 'posted' : 'not-posted');

      // Update data attribute for filtering
      card.dataset.status = newStatus === 'Posted' ? 'posted' : 'not_posted';

      applyFiltersWithStats();
    } else {
      alert('Failed to update status: ' + (data.error || 'Unknown error'));
      // Revert select
      select.value = newStatus === 'Posted' ? 'Not Posted' : 'Posted';
    }
  } catch (err) {
    alert('Network error updating status. Please try again.');
    select.value = newStatus === 'Posted' ? 'Not Posted' : 'Posted';
  } finally {
    card.classList.remove('updating');
  }
}

/* ────────────────────────────────────────────────────────────────────────────
   FIELD SAVE (PATCH on blur / change)
   ──────────────────────────────────────────────────────────────────────────── */
async function saveField(pinNumber, fieldName, fieldValue) {
  const flash = document.createElement('span');
  flash.className = 'save-flash';
  flash.textContent = 'Saving…';

  // Find the input/textarea and append flash
  let input;
  if (fieldName === 'notes') {
    input = document.getElementById('notes-' + pinNumber);
  } else if (fieldName === 'scheduled_date') {
    input = document.getElementById('scheduled-' + pinNumber);
  } else if (fieldName === 'published_date') {
    input = document.getElementById('published-' + pinNumber);
  }

  if (input && input.parentNode) {
    input.parentNode.appendChild(flash);
  }

  try {
    const body = {};
    body[fieldName] = fieldValue || null;

    const res = await fetch('/api/admin/pinterest-pins/' + pinNumber, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    const data = await res.json();

    if (res.ok && data.ok) {
      // Update card data attrs if needed
      if (fieldName === 'scheduled_date') {
        const card = document.getElementById('card-' + pinNumber);
        if (card) card.dataset.scheduled = fieldValue || '';
      }

      flash.textContent = '✓ Saved';
      flash.style.color = '#6dbe6d';
      setTimeout(() => { if (flash.parentNode) flash.parentNode.removeChild(flash); }, 2000);
    } else {
      flash.textContent = 'Failed';
      flash.style.color = '#be6d6d';
      setTimeout(() => { if (flash.parentNode) flash.parentNode.removeChild(flash); }, 2500);
    }
  } catch (err) {
    flash.textContent = 'Error';
    flash.style.color = '#be6d6d';
    setTimeout(() => { if (flash.parentNode) flash.parentNode.removeChild(flash); }, 2500);
  }
}

/* ────────────────────────────────────────────────────────────────────────────
   COPY TO CLIPBOARD
   ──────────────────────────────────────────────────────────────────────────── */
function copyText(btn, text) {
  if (!text) return;
  const cleanup = () => {
    btn.classList.remove('is-copied');
    if (originalText && btn.querySelector('.copy-label')) {
      btn.querySelector('.copy-label').textContent = originalText;
    }
  };

  const originalText = btn.querySelector('.copy-label') ? btn.querySelector('.copy-label').textContent : '';

  navigator.clipboard.writeText(text).then(() => {
    btn.classList.add('is-copied');
    setTimeout(cleanup, 1500);
  }).catch(() => {
    // Fallback
    const ta = document.createElement('textarea');
    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select(); document.execCommand('copy');
    document.body.removeChild(ta);
    btn.classList.add('is-copied');
    setTimeout(cleanup, 1500);
  });
}

/* ────────────────────────────────────────────────────────────────────────────
   INIT — apply default sort (Not Posted first)
   ──────────────────────────────────────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', () => {
  // Default: sort by status desc (posted last), then pin_number asc
  sortSelect.value = 'status';
  sortDirSelect.value = 'asc';
  applyFiltersWithStats();
});
</script>

<%- include('../partials/footer') %>