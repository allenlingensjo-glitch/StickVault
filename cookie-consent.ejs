<!-- GDPR Cookie Consent Banner
     Appears on first visit (localStorage key: sv_cookie_consent).
     Blocks GA4 until consent is granted. Matches dark vault aesthetic.
-->
<div id="cookie-banner" class="cookie-banner" style="display:none;" role="dialog" aria-label="Cookie consent" aria-live="polite">
  <div class="cookie-banner-inner">
    <p class="cookie-banner-text">
      We use cookies for analytics to improve your experience. No tracking until you say so.
      <a href="/cookie-policy" class="cookie-banner-link">Cookie Policy</a> &middot;
      <a href="/privacy-policy" class="cookie-banner-link">Privacy Policy</a>
    </p>
    <div class="cookie-banner-actions">
      <button id="cookie-reject" class="btn btn-ghost btn-sm cookie-btn-reject" type="button">Reject</button>
      <button id="cookie-accept" class="btn btn-primary btn-sm cookie-btn-accept" type="button">Accept</button>
    </div>
  </div>
</div>

<script>
(function () {
  var CONSENT_KEY = 'sv_cookie_consent';
  var banner = document.getElementById('cookie-banner');
  var existing = localStorage.getItem(CONSENT_KEY);

  // Helper: load GA4 only after explicit consent
  function loadGA4() {
    var ga4Id = '<%= typeof ga4Id !== "undefined" ? ga4Id : "" %>';
    if (!ga4Id) return;
    // Inject GA4 script dynamically
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
    document.head.appendChild(s);
    s.onload = function () {
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', ga4Id, { cookie_domain: 'stickvault.com', send_page_view: true });
    };
  }

  if (existing === 'accepted') {
    // Previously accepted — load GA4 immediately, no banner
    loadGA4();
    return;
  }

  if (existing === 'rejected') {
    // Previously rejected — no GA4, no banner
    return;
  }

  // First visit — show banner after a short delay so it doesn't block LCP
  setTimeout(function () {
    if (banner) banner.style.display = '';
  }, 800);

  document.getElementById('cookie-accept').addEventListener('click', function () {
    localStorage.setItem(CONSENT_KEY, 'accepted');
    banner.style.display = 'none';
    loadGA4();
  });

  document.getElementById('cookie-reject').addEventListener('click', function () {
    localStorage.setItem(CONSENT_KEY, 'rejected');
    banner.style.display = 'none';
  });
})();
</script>
