<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="success-section">
  <div class="container">
    <div class="success-inner">
      <!-- Checkmark icon -->
      <div class="success-icon">
        <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="32" cy="32" r="30" stroke="var(--gold)" stroke-width="2"/>
          <path d="M20 32 L28 40 L44 24" stroke="var(--gold)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <div class="section-label">You're in</div>
      <h1 class="success-title">Check your inbox.</h1>
      <p class="success-sub">Your free <strong>Drummer's Practice Toolkit</strong> is on its way. Should arrive within a minute — check your spam if you don't see it.</p>

      <!-- Download button (available immediately) -->
      <div class="success-download">
        <a href="<%= pdfUrl %>" class="btn btn-primary btn-download" download>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download The Drummer's Practice Toolkit
        </a>
        <p class="download-note">PDF · Instant access · No email required to download</p>
      </div>

      <!-- What's next -->
      <div class="success-next">
        <div class="section-label">While you wait</div>
        <h2 class="success-next-title">Start with the deep dives.</h2>
        <div class="success-next-grid">
          <a href="/blog" class="success-next-card">
            <div class="success-next-icon">📖</div>
            <div>
              <div class="success-next-card-title">Browse the Vault</div>
              <div class="success-next-card-sub">Drums, collecting, routines, side moves</div>
            </div>
          </a>
          <a href="/shop" class="success-next-card">
            <div class="success-next-icon">🏪</div>
            <div>
              <div class="success-next-card-title">Digital Guides</div>
              <div class="success-next-card-sub">Practice systems and collecting frameworks</div>
            </div>
          </a>
          <a href="/free" class="success-next-card">
            <div class="success-next-icon">🎁</div>
            <div>
              <div class="success-next-card-title">More Free Downloads</div>
              <div class="success-next-card-sub">Grading checklist + Operator's Playbook</div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.success-section {
  padding: 80px 0 100px;
  min-height: 70vh;
  display: flex;
  align-items: center;
}
.success-inner {
  max-width: 600px;
  margin: 0 auto;
  text-align: center;
}
.success-icon {
  margin-bottom: 32px;
  animation: successPop 0.5s ease-out;
}
@keyframes successPop {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.1); }
  100% { transform: scale(1); opacity: 1; }
}
.success-title {
  font-family: var(--font-heading);
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 700;
  color: var(--text-primary);
  margin: 0 0 16px;
  letter-spacing: -0.02em;
}
.success-sub {
  font-size: 1.1rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin: 0 0 40px;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}
.success-download {
  margin-bottom: 64px;
  padding: 32px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 12px;
}
.btn-download {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 1.1rem;
  padding: 14px 28px;
  margin-bottom: 12px;
  text-decoration: none;
}
.download-note {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin: 0;
}
.success-next-title {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0 0 24px;
}
.success-next-grid {
  display: grid;
  gap: 12px;
  text-align: left;
}
.success-next-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  text-decoration: none;
  transition: border-color 0.2s ease, transform 0.2s ease;
}
.success-next-card:hover {
  border-color: var(--gold);
  transform: translateX(4px);
}
.success-next-icon {
  font-size: 1.5rem;
  flex-shrink: 0;
}
.success-next-card-title {
  font-weight: 600;
  color: var(--text-primary);
  font-size: 1rem;
}
.success-next-card-sub {
  font-size: 0.85rem;
  color: var(--text-muted);
}
@media (max-width: 600px) {
  .success-download {
    padding: 24px 16px;
  }
  .btn-download {
    width: 100%;
    justify-content: center;
  }
}
</style>

<%- include('partials/footer') %>
<%- analyticsSnippet %>
<script src="/js/main.js"></script>
</body>
</html>