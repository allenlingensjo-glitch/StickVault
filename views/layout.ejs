<!-- Shared layout partial — included by per-page views via ejs-mate or direct render.
     Each page calls res.render('page-name', context) where page-name extends this layout. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= typeof title !== 'undefined' ? title : 'StickVault — Your Lifestyle Vault' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Curated deep dives on drums, collecting culture, side hustles, routines, and hidden gems.' %>">

  <!-- Open Graph / Pinterest -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="StickVault">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'StickVault — Your Lifestyle Vault' %>">
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Curated deep dives on drums, collecting culture, side hustles, and hidden gems.' %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : siteUrl + '/img/og-default.jpg' %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="pinterest-rich-pin" content="true">
  <% if (typeof pinterestDescription !== 'undefined') { %>
  <meta name="pinterest:description" content="<%= pinterestDescription %>">
  <% } %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'StickVault' %>">
  <meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : siteUrl + '/img/og-default.jpg' %>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&family=DM+Mono:ital,wght@0,400;0,500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <%- themeCSS %>
</head>
<body>
