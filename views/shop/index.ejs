<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<% if (typeof heroImage !== 'undefined' && heroImage) { %>
<img src="<%= heroImage %>" alt="StickVault Shop — Digital Guides for Serious Practitioners" class="hero-img-bg">
<% } %>

<section class="page-header">
  <div class="container">
    <div class="section-label">The Vault Shop</div>
    <h1 class="page-header-title">Systems, not PDFs.</h1>
    <p class="page-header-sub">Operational guides built for people who actually do the thing — collectors who grade and sell, drummers who practice seriously, people building real income on the side. Instant download.</p>
  </div>
</section>

<section class="shop-listing">
  <div class="container">
    <% if (products && products.length > 0) { %>
    <div class="products-grid">
      <% for (var i = 0; i < products.length; i++) { %>
      <% var product = products[i]; %>
      <div class="product-card fade-in">
        <a href="/shop/<%= product.slug %>" class="product-card-inner">
          <div class="product-card-top">
            <span class="product-cat product-cat--<%= product.category %>"><%= product.category ? product.category.replace(/-/g, ' ') : 'guide' %></span>
            <span class="product-price">$<%= (product.price_cents / 100).toFixed(0) %></span>
          </div>
          <h2 class="product-card-title"><%= product.title %></h2>
          <p class="product-card-desc"><%= product.description %></p>
          <% if (product.features && product.features.length > 0) { %>
          <div class="product-card-components">
            <span class="product-card-comp-count"><%= product.features.length %> components</span>
            <span class="product-card-comp-preview"><%= product.features[0].split('—')[0].trim().split(' ').slice(0,5).join(' ') %>...</span>
          </div>
          <% } %>
          <div class="product-card-footer">
            <span class="product-instant">⚡ Instant download</span>
            <span class="product-card-cta">See what's inside &rarr;</span>
          </div>
        </a>
        <div class="product-card-buy">
          <a href="<%= product.stripe_url %>" class="btn btn-primary product-buy-btn" target="_blank" rel="noopener">
            Buy for $<%= (product.price_cents / 100).toFixed(0) %>
          </a>
          <span class="product-card-secure">🔒 via Stripe</span>
        </div>
      </div>
      <% } %>
    </div>
    <% } else { %>
    <div class="empty-state">
      <p>Products coming soon.</p>
    </div>
    <% } %>
  </div>
</section>

<!-- Trust signals -->
<section class="shop-trust">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-item fade-in">
        <div class="trust-icon">⚡</div>
        <div class="trust-title">Instant Access</div>
        <div class="trust-text">Download link delivered immediately. No waiting, no accounts to create.</div>
      </div>
      <div class="trust-item fade-in">
        <div class="trust-icon">🔒</div>
        <div class="trust-title">Secure Checkout</div>
        <div class="trust-text">Powered by Stripe. Your payment details never touch our servers.</div>
      </div>
      <div class="trust-item fade-in">
        <div class="trust-icon">🗂</div>
        <div class="trust-title">Actual Systems</div>
        <div class="trust-text">Not generic advice dressed up as a template. Built for people doing the real work.</div>
      </div>
    </div>
  </div>
</section>

<!-- Email capture on shop — collector angle (most relevant audience) -->
<%- include('../partials/email-capture-collector', { source: 'shop-index' }) %>

<%- include('../partials/footer') %>
<%- analyticsSnippet %>
<script src="/js/main.js"></script>
</body>
</html>
