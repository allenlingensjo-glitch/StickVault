<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="error-page">
  <div class="container">
    <div class="error-inner">
      <div class="error-code">&#9679;</div>
      <h1 class="error-title"><%= typeof message !== 'undefined' ? message : 'Something went wrong.' %></h1>
      <p class="error-sub">The vault door might be stuck. Let's get you back inside.</p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Go Home</a>
        <a href="/blog" class="btn btn-ghost">Browse the Vault</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<%- analyticsSnippet %>
<script src="/js/main.js"></script>
</body>
</html>
