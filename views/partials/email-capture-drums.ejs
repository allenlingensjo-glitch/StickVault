<!-- Lead Magnet: Drums — "The Drummer's Practice Blueprint" -->
<!-- Drums-focused email capture. Context param: source (string) -->
<section class="email-capture email-capture--magnet email-capture--drums" id="vault-access-drums">
  <div class="container">
    <div class="magnet-block">
      <div class="magnet-preview">
        <div class="magnet-doc magnet-doc--drums">
          <div class="magnet-doc-header">
            <span class="magnet-doc-label">Free Blueprint</span>
            <span class="magnet-doc-title">Drummer's<br>Practice<br>Blueprint</span>
          </div>
          <ul class="magnet-doc-list">
            <li><span class="magnet-check">✓</span> Daily warm-up sequence (15 min)</li>
            <li><span class="magnet-check">✓</span> Rudiment progression framework</li>
            <li><span class="magnet-check">✓</span> Session logging format that sticks</li>
            <li><span class="magnet-check">✓</span> Gear maintenance checklist</li>
            <li><span class="magnet-check">✓</span> Stick selection decision matrix</li>
            <li><span class="magnet-check">✓</span> Practice-to-performance ratio guide</li>
          </ul>
        </div>
      </div>
      <div class="magnet-copy">
        <div class="section-label">Free Download</div>
        <h2 class="magnet-headline">The Drummer's<br>Practice Blueprint</h2>
        <p class="magnet-sub">A structured practice system built for drummers who take it seriously. What to work on, in what order, for how long — so every session moves the needle instead of burning time on the same patterns.</p>
        <div class="magnet-bullets">
          <div class="magnet-bullet">
            <span class="bullet-dot">◆</span>
            <span>Daily session structure from warm-up through focused drilling</span>
          </div>
          <div class="magnet-bullet">
            <span class="bullet-dot">◆</span>
            <span>Rudiment progression mapped to real-world application</span>
          </div>
          <div class="magnet-bullet">
            <span class="bullet-dot">◆</span>
            <span>Gear maintenance and stick selection frameworks</span>
          </div>
        </div>
        <form class="email-form email-form--magnet" data-source="<%= typeof source !== 'undefined' ? source : 'drums-magnet' %>" data-form-id="drums-magnet">
          <input
            type="email"
            name="email"
            placeholder="your@email.com"
            class="email-input"
            required
            autocomplete="email"
          >
          <button type="submit" class="btn btn-primary">Get the Blueprint</button>
        </form>
        <div class="email-form-message magnet-form-message" id="msg-drums-magnet" style="display:none;"></div>
        <p class="magnet-fine-print">Sent instantly. No spam. Unsubscribe anytime.</p>
      </div>
    </div>
  </div>
</section>
