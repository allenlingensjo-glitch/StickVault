<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<style>
  /* ── Layout ─────────────────────────────────────────────────────────────── */
  .admin-wrap { max-width: 1300px; margin: 0 auto; padding: 2rem 1.5rem 5rem; }

  .admin-header {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
  }
  .admin-header h1 { font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: var(--text-primary); margin: 0 0 0.25rem; }
  .admin-header p  { color: var(--text-secondary); font-size: 0.88rem; margin: 0; }

  .header-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; flex-shrink: 0; }

  /* ── Buttons ─────────────────────────────────────────────────────────────── */
  .btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.6rem 1.2rem; border-radius: 6px; font-weight: 700; font-size: 0.85rem;
    cursor: pointer; white-space: nowrap; border: none; text-decoration: none;
    transition: opacity .15s;
  }
  .btn:hover { opacity: .82; }
  .btn:disabled { opacity: .4; cursor: not-allowed; }
  .btn-gold  { background: var(--accent); color: #000; }
  .btn-ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
  .btn-dark  { background: var(--surface); color: var(--text-secondary); border: 1px solid var(--border); }
  .btn-sm { padding: 0.35rem 0.75rem; font-size: 0.78rem; }

  /* ── Summary stats ───────────────────────────────────────────────────────── */
  .summary-row { display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .summary-stat {
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
    padding: 0.9rem 1.4rem; text-align: center; min-width: 90px;
  }
  .summary-stat .num { font-size: 1.8rem; font-weight: 900; color: var(--accent); line-height: 1; margin-bottom: 0.2rem; }
  .summary-stat .lbl { font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .08em; }

  /* ── Progress bar ────────────────────────────────────────────────────────── */
  .in-progress-notice {
    background: #2a2010; border: 1px solid var(--accent); border-radius: 6px;
    padding: 0.75rem 1rem; color: var(--accent); font-size: 0.88rem; margin-bottom: 1.25rem; font-weight: 600;
  }

  /* ── Log section ─────────────────────────────────────────────────────────── */
  .log-section { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.2rem; margin-bottom: 1.5rem; }
  .log-section h3 { font-size: 0.8rem; color: var(--text-muted); margin: 0 0 0.6rem; }
  .log-lines { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-secondary); max-height: 180px; overflow-y: auto; line-height: 1.7; }

  /* ── Pillar section ──────────────────────────────────────────────────────── */
  .pillar-section { margin-bottom: 2.5rem; }
  .pillar-heading {
    display: flex; align-items: center; gap: 0.75rem;
    font-family: var(--font-display); font-size: 1.1rem; font-weight: 900;
    color: var(--text-primary); margin-bottom: 1rem;
    border-bottom: 1px solid var(--border); padding-bottom: 0.6rem;
  }
  .pillar-tag {
    font-size: 0.65rem; font-weight: 700; letter-spacing: .1em;
    padding: 0.2rem 0.55rem; border-radius: 3px;
    background: #2a2010; color: var(--accent); text-transform: uppercase;
  }
  .pillar-count { font-size: 0.75rem; color: var(--text-muted); font-weight: 400; font-family: var(--font-mono); }

  /* ── Pin cards ───────────────────────────────────────────────────────────── */
  .pin-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    margin-bottom: 1.25rem; overflow: hidden;
  }
  .pin-card.done     { border-left: 3px solid #4a9a4a; }
  .pin-card.failed   { border-left: 3px solid #9a4a4a; }
  .pin-card.generating { border-left: 3px solid var(--accent); }
  .pin-card.pending  { border-left: 3px solid #2a3a5a; }

  .pin-inner {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 0;
  }

  /* Thumbnail column */
  .pin-thumb-col { position: relative; }
  .pin-thumb {
    width: 120px; height: 180px; object-fit: cover; display: block;
    background: #111; border-right: 1px solid var(--border);
  }
  .pin-thumb-placeholder {
    width: 120px; height: 180px; background: #111;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.4rem; border-right: 1px solid var(--border);
  }
  .pin-thumb-placeholder span { font-size: 0.65rem; color: var(--text-muted); text-align: center; padding: 0 0.5rem; }
  .pin-download-btn {
    display: block; width: 120px;
    background: rgba(212,175,55,.12); color: var(--accent);
    text-align: center; font-size: 0.7rem; font-weight: 700;
    padding: 0.4rem 0; text-decoration: none; letter-spacing: .05em;
    border-top: 1px solid rgba(212,175,55,.2); transition: background .15s;
  }
  .pin-download-btn:hover { background: rgba(212,175,55,.24); }

  /* Main content column */
  .pin-content { padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.65rem; }

  .pin-header { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .pin-num { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); }
  .pin-pillar-tag { font-size: 0.62rem; font-weight: 700; letter-spacing: .08em; color: var(--accent); text-transform: uppercase; }
  .pin-status-badge {
    font-size: 0.62rem; padding: 0.15rem 0.45rem; border-radius: 3px;
    font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
  }
  .status-done     { background: #1a3a1a; color: #6dbe6d; }
  .status-pending  { background: #1a1a2a; color: #6d8dbe; }
  .status-failed   { background: #3a1a1a; color: #be6d6d; }
  .status-generating { background: #2a2010; color: var(--accent); }

  .pin-headline { font-size: 0.88rem; font-weight: 700; color: var(--text-primary); line-height: 1.4; }

  /* Field rows */
  .field-row { display: flex; flex-direction: column; gap: 0.15rem; }
  .field-label {
    font-size: 0.65rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--text-muted); font-weight: 600;
  }
  .field-value-wrap { display: flex; align-items: flex-start; gap: 0.5rem; }
  .field-value {
    font-size: 0.78rem; color: var(--text-secondary); line-height: 1.5;
    flex: 1; word-break: break-word;
  }
  .field-value a { color: var(--accent); text-decoration: none; }
  .field-value a:hover { text-decoration: underline; }
  .copy-btn {
    flex-shrink: 0; background: transparent; border: 1px solid var(--border);
    color: var(--text-muted); cursor: pointer; border-radius: 4px;
    padding: 0.15rem 0.45rem; font-size: 0.68rem; transition: all .15s;
    margin-top: 0.1rem;
  }
  .copy-btn:hover { border-color: var(--accent); color: var(--accent); }
  .copy-btn.copied { border-color: #4a9a4a; color: #6dbe6d; }

  /* Meta pills row */
  .meta-pills { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
  .meta-pill {
    font-size: 0.68rem; padding: 0.2rem 0.6rem; border-radius: 20px;
    border: 1px solid var(--border); color: var(--text-secondary);
    background: rgba(255,255,255,.03);
  }
  .meta-pill.board { border-color: rgba(212,175,55,.3); color: var(--accent); }
  .meta-pill.cta   { border-color: rgba(100,150,255,.3); color: #7aaeee; }
  .meta-pill.pillar{ border-color: rgba(212,175,55,.2); color: var(--accent); background: rgba(212,175,55,.06); }

  /* Workflow row */
  .workflow-row {
    display: flex; gap: 0.75rem; align-items: flex-start; flex-wrap: wrap;
    padding-top: 0.5rem; border-top: 1px solid var(--border); margin-top: 0.25rem;
  }
  .workflow-group { display: flex; flex-direction: column; gap: 0.25rem; flex: 1; min-width: 120px; }
  .workflow-label { font-size: 0.65rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); font-weight: 600; }
  .workflow-select {
    background: #111; border: 1px solid var(--border); color: var(--text-primary);
    padding: 0.35rem 0.6rem; border-radius: 5px; font-size: 0.8rem; cursor: pointer;
    transition: border-color .15s;
  }
  .workflow-select:focus { outline: none; border-color: var(--accent); }
  .workflow-select option { background: #111; }
  .select-posted   { border-color: #4a9a4a !important; color: #6dbe6d; }
  .select-needs    { border-color: #9a7a2a !important; color: #d4a84a; }
  .workflow-notes {
    background: #111; border: 1px solid var(--border); color: var(--text-secondary);
    padding: 0.35rem 0.6rem; border-radius: 5px; font-size: 0.78rem;
    resize: vertical; min-height: 52px; font-family: inherit; flex: 2; min-width: 200px;
    transition: border-color .15s;
  }
  .workflow-notes:focus { outline: none; border-color: var(--accent); }
  .workflow-save-btn {
    background: transparent; border: 1px solid var(--border); color: var(--text-muted);
    padding: 0.35rem 0.75rem; border-radius: 5px; font-size: 0.75rem; font-weight: 600;
    cursor: pointer; transition: all .15s; align-self: flex-end;
  }
  .workflow-save-btn:hover { border-color: var(--accent); color: var(--accent); }
  .workflow-save-btn.saving { opacity: .5; cursor: not-allowed; }
  .workflow-save-btn.saved  { border-color: #4a9a4a; color: #6dbe6d; }

  /* Expandable details */
  .expand-toggle {
    background: none; border: none; color: var(--text-muted); font-size: 0.72rem;
    cursor: pointer; padding: 0; display: flex; align-items: center; gap: 0.3rem;
    transition: color .15s;
  }
  .expand-toggle:hover { color: var(--accent); }
  .expand-body { display: none; }
  .expand-body.open { display: flex; flex-direction: column; gap: 0.65rem; padding-top: 0.5rem; border-top: 1px dashed rgba(255,255,255,.06); margin-top: 0.25rem; }

  /* Keywords */
  .keyword-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .keyword-tag  { font-size: 0.65rem; padding: 0.15rem 0.5rem; border-radius: 20px; background: rgba(212,175,55,.08); border: 1px solid rgba(212,175,55,.2); color: var(--accent); }

  /* ── Responsive ──────────────────────────────────────────────────────────── */
  @media (max-width: 600px) {
    .pin-inner { grid-template-columns: 80px 1fr; }
    .pin-thumb, .pin-thumb-placeholder, .pin-download-btn { width: 80px; }
    .pin-thumb { height: 120px; }
    .pin-thumb-placeholder { height: 120px; }
  }
</style>

<div class="admin-wrap">

  <!-- ── Header ──────────────────────────────────────────────────────────────── -->
  <div class="admin-header">
    <div>
      <h1>Pinterest Pins</h1>
      <p>30 marketing pins across 5 pillars. Download → paste description → add UTM link → schedule.</p>
    </div>
    <div class="header-actions">
      <a href="/api/pinterest-pins/export.csv" class="btn btn-dark btn-sm">⬇ Export CSV</a>
      <a href="/api/pinterest-pins/batch.zip" class="btn btn-ghost btn-sm">⬇ Download All ZIP</a>
      <button class="btn btn-gold" id="generateBtn" <%= inProgress ? 'disabled' : '' %> onclick="triggerGeneration()">
        <%= inProgress ? '⚡ Generating…' : 'Generate Pending Pins' %>
      </button>
    </div>
  </div>

  <% if (inProgress) { %>
  <div class="in-progress-notice">⚡ Generation in progress — page auto-refreshes every 15 s</div>
  <% } %>

  <!-- ── Summary ─────────────────────────────────────────────────────────────── -->
  <div class="summary-row">
    <div class="summary-stat"><div class="num"><%= summary.done %></div><div class="lbl">Done</div></div>
    <div class="summary-stat"><div class="num"><%= summary.pending %></div><div class="lbl">Pending</div></div>
    <div class="summary-stat"><div class="num"><%= summary.generating %></div><div class="lbl">Generating</div></div>
    <div class="summary-stat"><div class="num"><%= summary.failed %></div><div class="lbl">Failed</div></div>
    <div class="summary-stat"><div class="num"><%= summary.total %></div><div class="lbl">Total</div></div>
  </div>

  <% if (recentLog.length > 0) { %>
  <div class="log-section">
    <h3>Generation Log</h3>
    <div class="log-lines"><% recentLog.forEach(l => { %><%= l %><br><% }) %></div>
  </div>
  <% } %>

  <!-- ── Pins grouped by pillar ──────────────────────────────────────────────── -->
  <%
    const PILLAR_ORDER = ['COLLECTING','DRUMS','ROUTINES','DISCOVERY','OPERATOR'];
    const PILLAR_LABELS = {
      COLLECTING: 'Collecting',
      DRUMS:      'Drums',
      ROUTINES:   'Routines',
      DISCOVERY:  'Hidden Gems',
      OPERATOR:   'Operator',
    };
    const grouped = {};
    PILLAR_ORDER.forEach(p => { grouped[p] = []; });
    pins.forEach(pin => { if (grouped[pin.pillar]) grouped[pin.pillar].push(pin); });

    function pad(n) { return String(n).padStart(2,'0'); }
    function safe(v) { return (v || '').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  %>

  <% PILLAR_ORDER.forEach(pillar => { %>
  <% const group = grouped[pillar]; if (!group.length) return; %>
  <div class="pillar-section">
    <div class="pillar-heading">
      <span class="pillar-tag"><%= PILLAR_LABELS[pillar] %></span>
      <span class="pillar-count"><%= group.length %> pins</span>
    </div>

    <% group.forEach(pin => { %>
    <%
      const pinId = 'pin' + pin.pin_number;
      const numPad = pad(pin.pin_number);
      const descText = pin.description || '';
      const destUrl = pin.destination_url || '';
      const utmUrl  = pin.utm_url || '';
      const board   = pin.board || '';
      const keywords = pin.keywords || '';
      const cta     = pin.cta_angle || '';
      const funnel  = pin.funnel_pillar || '';
      const postingStatus = pin.posting_status || 'Not Posted';
      const notes   = pin.notes || '';
      const kwList  = keywords ? keywords.split(',').map(k => k.trim()).filter(Boolean) : [];
    %>
    <div class="pin-card <%= pin.status %>" id="card-<%= pin.pin_number %>">
      <div class="pin-inner">

        <!-- Thumb column -->
        <div class="pin-thumb-col">
          <% if (pin.r2_url) { %>
            <img class="pin-thumb" src="<%= pin.r2_url %>" alt="Pin <%= numPad %>" loading="lazy">
            <a href="<%= pin.r2_url %>" download="pin_<%= numPad %>.png" class="pin-download-btn">⬇ pin_<%= numPad %>.png</a>
          <% } else { %>
            <div class="pin-thumb-placeholder">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.15)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              <span><%= pin.status === 'generating' ? '⚡ generating' : pin.status === 'failed' ? '✕ failed' : 'not generated' %></span>
            </div>
          <% } %>
        </div>

        <!-- Content column -->
        <div class="pin-content">

          <!-- Header row -->
          <div class="pin-header">
            <span class="pin-num">PIN-<%= numPad %></span>
            <span class="pin-pillar-tag"><%= pin.pillar %></span>
            <span class="pin-status-badge status-<%= pin.status %>"><%= pin.status.toUpperCase() %></span>
          </div>

          <!-- Headline + copy -->
          <div class="field-row">
            <div class="field-label">Pinterest Title</div>
            <div class="field-value-wrap">
              <div class="field-value pin-headline"><%= pin.headline %></div>
              <button class="copy-btn" onclick="copyText(this, <%= JSON.stringify(pin.headline) %>)" title="Copy title">Copy</button>
            </div>
          </div>

          <!-- Description + copy -->
          <% if (descText) { %>
          <div class="field-row">
            <div class="field-label">Pinterest Description</div>
            <div class="field-value-wrap">
              <div class="field-value" style="font-size:0.75rem;"><%= descText %></div>
              <button class="copy-btn" onclick="copyText(this, <%= JSON.stringify(descText) %>)" title="Copy description">Copy</button>
            </div>
          </div>
          <% } %>

          <!-- Destination + UTM -->
          <div class="field-row">
            <div class="field-label">Destination URL</div>
            <div class="field-value-wrap">
              <div class="field-value">
                <% if (destUrl) { %><a href="<%= destUrl %>" target="_blank"><%= destUrl %></a><% } else { %><span style="color:var(--text-muted)">—</span><% } %>
              </div>
              <% if (destUrl) { %><button class="copy-btn" onclick="copyText(this, <%= JSON.stringify(destUrl) %>)" title="Copy URL">Copy</button><% } %>
            </div>
          </div>

          <% if (utmUrl) { %>
          <div class="field-row">
            <div class="field-label">UTM-Tagged URL</div>
            <div class="field-value-wrap">
              <div class="field-value" style="font-size:0.72rem;word-break:break-all;"><%= utmUrl %></div>
              <button class="copy-btn" onclick="copyText(this, <%= JSON.stringify(utmUrl) %>)" title="Copy UTM URL">Copy</button>
            </div>
          </div>
          <% } %>

          <!-- Meta pills -->
          <div class="meta-pills">
            <% if (board)  { %><span class="meta-pill board">📌 <%= board %></span><% } %>
            <% if (cta)    { %><span class="meta-pill cta">→ <%= cta %></span><% } %>
            <% if (funnel) { %><span class="meta-pill pillar"><%= funnel %></span><% } %>
          </div>

          <!-- Expandable: Keywords -->
          <% if (kwList.length) { %>
          <div>
            <button class="expand-toggle" onclick="toggleExpand('<%= pinId %>-kw', this)">
              <span>▶</span> Keywords &amp; tags (<%= kwList.length %>)
            </button>
            <div class="expand-body" id="<%= pinId %>-kw">
              <div class="keyword-tags">
                <% kwList.forEach(kw => { %><span class="keyword-tag"><%= kw %></span><% }) %>
              </div>
              <div class="field-value-wrap">
                <div class="field-value" style="font-size:0.72rem;color:var(--text-muted)"><%= keywords %></div>
                <button class="copy-btn" onclick="copyText(this, <%= JSON.stringify(keywords) %>)" title="Copy all keywords">Copy all</button>
              </div>
            </div>
          </div>
          <% } %>

          <!-- Workflow row -->
          <div class="workflow-row" id="workflow-<%= pin.pin_number %>">
            <div class="workflow-group" style="max-width:160px;">
              <div class="workflow-label">Status</div>
              <select class="workflow-select <%= postingStatus === 'Posted' ? 'select-posted' : postingStatus === 'Needs Edit' ? 'select-needs' : '' %>"
                      id="status-<%= pin.pin_number %>"
                      onchange="this.className='workflow-select ' + (this.value==='Posted'?'select-posted':this.value==='Needs Edit'?'select-needs':'')">
                <option value="Not Posted" <%= postingStatus === 'Not Posted' ? 'selected' : '' %>>Not Posted</option>
                <option value="Posted"     <%= postingStatus === 'Posted'     ? 'selected' : '' %>>Posted ✓</option>
                <option value="Needs Edit" <%= postingStatus === 'Needs Edit' ? 'selected' : '' %>>Needs Edit</option>
              </select>
            </div>
            <div class="workflow-group">
              <div class="workflow-label">Notes</div>
              <textarea class="workflow-notes" id="notes-<%= pin.pin_number %>" placeholder="Scheduling date, edit reminders, perf notes…"><%= notes %></textarea>
            </div>
            <button class="workflow-save-btn" onclick="saveWorkflow(<%= pin.pin_number %>, this)">Save</button>
          </div>

        </div><!-- /pin-content -->
      </div><!-- /pin-inner -->
    </div><!-- /pin-card -->
    <% }) %>
  </div><!-- /pillar-section -->
  <% }) %>

</div><!-- /admin-wrap -->

<script>
/* ── Copy to clipboard ─────────────────────────────────────────────────────── */
function copyText(btn, text) {
  navigator.clipboard.writeText(text).then(() => {
    btn.classList.add('copied');
    const orig = btn.textContent;
    btn.textContent = '✓';
    setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 1500);
  }).catch(() => {
    // Fallback
    const ta = document.createElement('textarea');
    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select(); document.execCommand('copy');
    document.body.removeChild(ta);
    btn.classList.add('copied'); const orig = btn.textContent; btn.textContent = '✓';
    setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 1500);
  });
}

/* ── Expand/collapse sections ─────────────────────────────────────────────── */
function toggleExpand(id, btn) {
  const el = document.getElementById(id);
  const arrow = btn.querySelector('span');
  if (!el) return;
  const open = el.classList.toggle('open');
  if (arrow) arrow.textContent = open ? '▼' : '▶';
}

/* ── Save workflow (posting_status + notes) ───────────────────────────────── */
function saveWorkflow(pinNum, btn) {
  const statusEl = document.getElementById('status-' + pinNum);
  const notesEl  = document.getElementById('notes-'  + pinNum);
  if (!statusEl || !notesEl) return;
  btn.classList.add('saving'); btn.disabled = true; btn.textContent = 'Saving…';

  fetch('/api/pinterest-pins/' + pinNum, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ posting_status: statusEl.value, notes: notesEl.value }),
  })
  .then(r => r.json())
  .then(d => {
    btn.classList.remove('saving');
    if (d.ok) {
      btn.classList.add('saved'); btn.textContent = 'Saved ✓';
      setTimeout(() => { btn.classList.remove('saved'); btn.textContent = 'Save'; btn.disabled = false; }, 2000);
    } else {
      btn.textContent = 'Error'; btn.disabled = false;
    }
  })
  .catch(() => { btn.textContent = 'Error'; btn.disabled = false; btn.classList.remove('saving'); });
}

/* ── Trigger batch generation ─────────────────────────────────────────────── */
function triggerGeneration() {
  const btn = document.getElementById('generateBtn');
  if (!btn || btn.disabled) return;
  btn.disabled = true; btn.textContent = '⚡ Starting…';
  fetch('/api/pinterest-pins/generate', {
    method: 'POST',
    headers: { 'Authorization': 'Bearer <%= process.env.POLSIA_API_KEY || "" %>' },
  })
  .then(r => r.json())
  .then(d => {
    if (d.started) { btn.textContent = '⚡ Generating…'; setTimeout(() => location.reload(), 3000); }
    else { btn.textContent = 'Error — retry'; btn.disabled = false; }
  })
  .catch(() => { btn.textContent = 'Error — retry'; btn.disabled = false; });
}

<% if (inProgress) { %>
setTimeout(() => location.reload(), 15000);
<% } %>
</script>

