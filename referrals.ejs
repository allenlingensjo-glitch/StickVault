<%- include('../partials/head', { title: 'Referrals — StickVault Admin' }) %>
<%- include('../partials/nav') %>

<style>
  /* ── Layout ─────────────────────────────────────────────────────────────── */
  .admin-wrap { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem 5rem; }
  .admin-header {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem;
  }
  .admin-header h1 { font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: var(--text-primary); margin: 0 0 0.3rem; }
  .admin-header p  { color: var(--text-secondary); font-size: 0.88rem; margin: 0; }

  /* ── Buttons ────────────────────────────────────────────────────────────── */
  .btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.6rem 1.2rem; border-radius: 6px; font-weight: 700; font-size: 0.85rem;
    cursor: pointer; white-space: nowrap; border: none; text-decoration: none; transition: opacity .15s;
  }
  .btn:hover { opacity: .82; }
  .btn-gold  { background: var(--accent); color: #000; }
  .btn-ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
  .btn-dark  { background: var(--surface); color: var(--text-secondary); border: 1px solid var(--border); }
  .header-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  /* ── Summary cards ──────────────────────────────────────────────────────── */
  .summary-row { display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .summary-stat {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 1rem 1.5rem; min-width: 130px; flex: 1;
  }
  .summary-stat .num  { font-size: 1.9rem; font-weight: 900; color: var(--accent); line-height: 1; margin-bottom: 0.3rem; }
  .summary-stat .lbl  { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .1em; }
  .summary-stat .sub  { font-size: 0.72rem; color: var(--text-secondary); margin-top: 0.3rem; }

  /* ── Section headers ─────────────────────────────────────────────────────── */
  .section-header {
    font-family: var(--font-display); font-size: 0.75rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .1em; color: var(--text-secondary);
    margin: 2rem 0 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);
  }

  /* ── Charts / stats grid ────────────────────────────────────────────────── */
  .chart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
  @media (max-width: 700px) { .chart-grid { grid-template-columns: 1fr; } }
  .chart-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 1.25rem;
  }
  .chart-title {
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .08em; color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  /* Monthly chart bars */
  .monthly-bars { display: flex; align-items: flex-end; gap: 0.5rem; height: 80px; }
  .bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 0.25rem; height: 100%; justify-content: flex-end; }
  .bar     { width: 100%; background: var(--accent); border-radius: 3px 3px 0 0; min-height: 2px; opacity: 0.75; transition: opacity .15s; }
  .bar:hover { opacity: 1; }
  .bar-lbl { font-family: var(--font-mono); font-size: 0.6rem; color: var(--text-muted); text-align: center; }

  /* Category list */
  .cat-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .cat-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.5rem 0.75rem; background: var(--bg); border-radius: 6px;
    border: 1px solid var(--border);
  }
  .cat-name    { font-size: 0.82rem; color: var(--text-primary); font-weight: 600; }
  .cat-bar-wrap { flex: 1; margin: 0 0.75rem; height: 4px; background: var(--border); border-radius: 2px; }
  .cat-bar      { height: 100%; background: var(--accent); border-radius: 2px; }
  .cat-commission { font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent); font-weight: 700; }

  /* Top links table */
  .top-links-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
  .top-links-table th {
    text-align: left; font-family: var(--font-mono); font-size: 0.68rem;
    font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted);
    padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border);
  }
  .top-links-table td { padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .top-links-table tr:last-child td { border-bottom: none; }
  .top-links-table tr:hover td { background: rgba(255,255,255,0.02); }

  /* Orders table */
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  thead th {
    text-align: left; font-family: var(--font-mono); font-size: 0.7rem;
    font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted);
    padding: 0.65rem 1rem; border-bottom: 1px solid var(--border); white-space: nowrap;
  }
  tbody tr { transition: background .15s; }
  tbody tr:hover { background: var(--bg-raised); }
  tbody td { padding: 0.7rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle; }
  .order-id   { font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent); }
  .date-cell  { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.75rem; white-space: nowrap; }
  .amount-cell{ font-family: var(--font-mono); font-weight: 700; color: var(--text-primary); text-align: right; }
  .comm-cell  { font-family: var(--font-mono); color: var(--accent); font-weight: 700; text-align: right; }
  .status-badge {
    display: inline-block; padding: 0.18rem 0.6rem; border-radius: 20px;
    font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em;
  }
  .status-approved  { background: rgba(80,200,140,0.15); color: #50c88c; }
  .status-paid      { background: rgba(80,160,255,0.15); color: #50a0ff; }
  .status-pending   { background: rgba(212,175,55,0.15); color: var(--accent); }
  .status-removed   { background: rgba(255,80,80,0.10); color: #e05252; }
  .category-tag {
    display: inline-block; padding: 0.18rem 0.6rem; background: var(--bg); color: var(--text-secondary);
    border-radius: 4px; font-size: 0.7rem; font-weight: 600; border: 1px solid var(--border);
  }
  .link-slug { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); opacity: 0.8; }

  /* Empty state */
  .empty-state { padding: 3rem; text-align: center; color: var(--text-secondary); font-size: 0.9rem; }

  /* Admin nav */
  .admin-nav {
    margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
    display: flex; gap: 1.5rem; flex-wrap: wrap;
  }
  .admin-nav a {
    font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted);
    text-decoration: none; text-transform: uppercase; letter-spacing: .08em; transition: color .15s;
  }
  .admin-nav a:hover { color: var(--accent); }

  @media (max-width: 600px) {
    .admin-header h1 { font-size: 1.4rem; }
    .summary-row { gap: 0.6rem; }
    .summary-stat { min-width: 100px; }
  }
</style>

<div class="admin-wrap">
  <!-- Header -->
  <div class="admin-header">
    <div>
      <h1>Affiliate Referrals</h1>
      <p>Amazon Associates commissions — clicks, orders, and earnings by link.</p>
    </div>
    <div class="header-actions">
      <a href="/api/admin/referrals/export" class="btn btn-gold">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Export CSV
      </a>
    </div>
  </div>

  <!-- Summary stat cards -->
  <div class="summary-row">
    <div class="summary-stat">
      <div class="num"><%= totals.total_orders %></div>
      <div class="lbl">Total Orders</div>
    </div>
    <div class="summary-stat">
      <div class="num">$<%= parseFloat(totals.total_sales || 0).toFixed(2) %></div>
      <div class="lbl">Total Sales</div>
    </div>
    <div class="summary-stat">
      <div class="num">$<%= parseFloat(totals.total_commission || 0).toFixed(2) %></div>
      <div class="lbl">Total Commission</div>
    </div>
    <% if (statuses.find(s => s.status === 'pending')) { %>
    <% const p = statuses.find(s => s.status === 'pending'); %>
    <div class="summary-stat">
      <div class="num">$<%= parseFloat(p.total_commission || 0).toFixed(2) %></div>
      <div class="lbl">Pending</div>
      <div class="sub"><%= p.order_count %> orders</div>
    </div>
    <% } %>
    <% if (statuses.find(s => s.status === 'paid')) { %>
    <% const pd = statuses.find(s => s.status === 'paid'); %>
    <div class="summary-stat">
      <div class="num">$<%= parseFloat(pd.total_commission || 0).toFixed(2) %></div>
      <div class="lbl">Paid Out</div>
    </div>
    <% } %>
  </div>

  <!-- Monthly Commission Chart + Category Breakdown -->
  <% if (monthly.length > 0) { %>
  <div class="chart-grid">
    <!-- Monthly commission trend -->
    <div class="chart-card">
      <div class="chart-title">Monthly Commission ($)</div>
      <div class="monthly-bars">
        <% const maxComm = Math.max(...monthly.map(m => parseFloat(m.total_commission || 0)), 1); %>
        <% monthly.forEach(m => { %>
        <div class="bar-wrap" title="<%= m.label %>: $<%= parseFloat(m.total_commission || 0).toFixed(2) %>">
          <div class="bar" style="height: <%= Math.max((parseFloat(m.total_commission) / maxComm) * 100, 3) %>%;"></div>
          <div class="bar-lbl"><%= m.label.split(' ')[0].slice(0,3) %></div>
        </div>
        <% }); %>
      </div>
    </div>

    <!-- Category breakdown -->
    <div class="chart-card">
      <div class="chart-title">By Category</div>
      <div class="cat-list">
        <% const maxCat = Math.max(...categories.map(c => parseFloat(c.total_commission || 0)), 1); %>
        <% categories.slice(0, 5).forEach(c => { %>
        <div class="cat-item">
          <span class="cat-name"><%= c.category %></span>
          <div class="cat-bar-wrap">
            <div class="cat-bar" style="width: <%= Math.round((parseFloat(c.total_commission) / maxCat) * 100) %>%;"></div>
          </div>
          <span class="cat-commission">$<%= parseFloat(c.total_commission || 0).toFixed(2) %></span>
        </div>
        <% }); %>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Top Performing Links -->
  <% if (topLinks.length > 0) { %>
  <div class="section-header">Top Performing Links</div>
  <div class="table-wrap" style="margin-bottom: 2rem;">
    <table class="top-links-table">
      <thead>
        <tr>
          <th>Link</th>
          <th>Type</th>
          <th>Pillar</th>
          <th style="text-align:right;">Clicks</th>
          <th style="text-align:right;">Orders</th>
          <th style="text-align:right;">Sales</th>
          <th style="text-align:right;">Commission</th>
        </tr>
      </thead>
      <tbody>
        <% topLinks.forEach(l => { %>
        <tr>
          <td>
            <div style="font-weight:600;color:var(--text-primary)"><%= l.label %></div>
            <div class="link-slug">/r/<%= l.slug %></div>
          </td>
          <td><span style="font-size:0.75rem;color:var(--text-secondary)"><%= l.link_type %></span></td>
          <td><% if (l.pillar) { %><span class="category-tag"><%= l.pillar %></span><% } else { %>—<% } %></td>
          <td style="text-align:right;font-family:var(--font-mono)"><%= l.click_count %></td>
          <td style="text-align:right;font-family:var(--font-mono)"><%= l.order_count %></td>
          <td class="amount-cell">$<%= parseFloat(l.total_sales || 0).toFixed(2) %></td>
          <td class="comm-cell">$<%= parseFloat(l.total_commission || 0).toFixed(2) %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>

  <!-- All Orders -->
  <div class="section-header">All Orders</div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Date</th>
          <th>Program</th>
          <th>Category</th>
          <th>Link</th>
          <th>Amount</th>
          <th>Commission</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders.length === 0) { %>
        <tr><td colspan="8" class="empty-state">No referral orders yet. Orders are populated via Amazon Associates API or manual import.</td></tr>
        <% } else { %>
        <% orders.forEach(o => { %>
        <tr>
          <td class="order-id"><%= o.order_id %></td>
          <td class="date-cell"><%= o.order_date %></td>
          <td style="color:var(--text-secondary);font-size:0.82rem"><%= o.program %></td>
          <td><% if (o.category) { %><span class="category-tag"><%= o.category %></span><% } else { %>—<% } %></td>
          <td><% if (o.slug) { %><span class="link-slug">/r/<%= o.slug %></span><% } else { %>—<% } %></td>
          <td class="amount-cell">$<%= parseFloat(o.amount_usd).toFixed(2) %></td>
          <td class="comm-cell">$<%= parseFloat(o.commission_usd).toFixed(2) %></td>
          <td><span class="status-badge status-<%= o.status %>"><%= o.status %></span></td>
        </tr>
        <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Admin nav -->
  <div class="admin-nav">
    <a href="/admin/analytics">← Analytics</a>
    <a href="/admin/subscribers">Subscribers</a>
    <a href="/admin/links">Affiliate Links</a>
    <a href="/admin/pinterest-dashboard">Pinterest</a>
  </div>
</div>

<%- include('../partials/footer') %>