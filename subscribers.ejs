<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<style>
  /* ── Layout ─────────────────────────────────────────────────────────────── */
  .admin-wrap { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 5rem; }

  /* ── Header ──────────────────────────────────────────────────────────────── */
  .admin-header {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem;
  }
  .admin-header h1 {
    font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: var(--text-primary); margin: 0 0 0.3rem;
  }
  .admin-header p { color: var(--text-secondary); font-size: 0.88rem; margin: 0; }

  /* ── Buttons ────────────────────────────────────────────────────────────── */
  .btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.6rem 1.2rem; border-radius: 6px; font-weight: 700; font-size: 0.85rem;
    cursor: pointer; white-space: nowrap; border: none; text-decoration: none;
    transition: opacity .15s;
  }
  .btn:hover { opacity: .82; }
  .btn-gold  { background: var(--accent); color: #000; }
  .btn-ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
  .btn-dark  { background: var(--surface); color: var(--text-secondary); border: 1px solid var(--border); }
  .header-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  /* ── Summary cards ──────────────────────────────────────────────────────── */
  .summary-row { display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .summary-stat {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 1rem 1.5rem; min-width: 110px;
  }
  .summary-stat .num { font-size: 1.9rem; font-weight: 900; color: var(--accent); line-height: 1; margin-bottom: 0.3rem; }
  .summary-stat .lbl { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .1em; }
  .summary-stat .sub { font-size: 0.72rem; color: var(--text-secondary); margin-top: 0.3rem; }

  /* ── Table ──────────────────────────────────────────────────────────────── */
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }

  thead th {
    text-align: left; font-family: var(--font-mono); font-size: 0.7rem;
    font-weight: 600; text-transform: uppercase; letter-spacing: .1em;
    color: var(--text-muted); padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--border); white-space: nowrap;
  }
  thead th a {
    color: var(--text-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem;
  }
  thead th a:hover { color: var(--accent); }
  thead th .sort-icon { font-size: 0.6rem; opacity: .5; }
  thead th.sorted .sort-icon { opacity: 1; color: var(--accent); }

  tbody tr { transition: background .15s; }
  tbody tr:hover { background: var(--bg-raised); }
  tbody td { padding: 0.75rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle; }

  .email { color: var(--text-primary); font-family: var(--font-mono); font-size: 0.82rem; }
  .source-tag {
    display: inline-block; padding: 0.2rem 0.6rem;
    background: var(--accent-dim); color: var(--accent);
    border-radius: 4px; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: .06em;
  }
  .date { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.75rem; }

  /* ── Footer nav ─────────────────────────────────────────────────────────── */
  .admin-nav {
    margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
    display: flex; gap: 1.5rem; flex-wrap: wrap;
  }
  .admin-nav a {
    font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted);
    text-decoration: none; text-transform: uppercase; letter-spacing: .08em;
    transition: color .15s;
  }
  .admin-nav a:hover { color: var(--accent); }

  /* ── Mobile ─────────────────────────────────────────────────────────────── */
  @media (max-width: 600px) {
    .admin-header h1 { font-size: 1.4rem; }
    .summary-row { gap: 0.6rem; }
    .summary-stat { min-width: 90px; padding: 0.75rem 1rem; }
  }
</style>

<div class="admin-wrap">
  <!-- Header -->
  <div class="admin-header">
    <div>
      <h1>Email Subscribers</h1>
      <p>All signups across homepage, free page, and blog footer.</p>
    </div>
    <div class="header-actions">
      <a href="/api/admin/subscribers/export" class="btn btn-gold">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Export CSV
      </a>
    </div>
  </div>

  <!-- Summary counts -->
  <div class="summary-row">
    <div class="summary-stat">
      <div class="num"><%= counts.total %></div>
      <div class="lbl">Total</div>
    </div>
    <% counts.bySource.forEach(function(src) { %>
    <div class="summary-stat">
      <div class="num"><%= src.count %></div>
      <div class="lbl"><%= src.source %></div>
    </div>
    <% }); %>
  </div>

  <!-- Table -->
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <% function sortLink(col, label) {
            const isCurrent = sort === col;
            const nextOrder = isCurrent && order === 'DESC' ? 'ASC' : 'DESC';
            const icon = isCurrent ? (order === 'DESC' ? '↓' : '↑') : '↕';
            const cls = isCurrent ? 'sorted' : '';
            return `<th class="${cls}"><a href="/admin/subscribers?sort=${col}&order=${nextOrder}">${label} <span class="sort-icon">${icon}</span></a></th>`;
          } %>
          <%- sortLink('email', 'Email') %>
          <%- sortLink('source', 'Source') %>
          <%- sortLink('created_at', 'Subscribed') %>
        </tr>
      </thead>
      <tbody>
        <% if (subscribers.length === 0) { %>
          <tr><td colspan="3" style="text-align:center; color: var(--text-muted); padding: 3rem;">No subscribers yet.</td></tr>
        <% } else { %>
          <% subscribers.forEach(function(s) { %>
          <tr>
            <td class="email"><%= s.email %></td>
            <td><span class="source-tag"><%= s.source %></span></td>
            <td class="date"><%= s.created_at.toISOString().slice(0,10) %> <%= s.created_at.toISOString().slice(11,16) %></td>
          </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Admin nav -->
  <div class="admin-nav">
    <a href="/admin/analytics">← Analytics</a>
    <a href="/admin/pinterest-dashboard">Pinterest Pins</a>
    <a href="/admin/links">Affiliate Links</a>
    <a href="/admin/pinterest-queue">Posting Queue</a>
  </div>
</div>

<%- include('../partials/footer') %>