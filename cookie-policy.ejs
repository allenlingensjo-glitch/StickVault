          <tr>
            <td>Stripe</td>
            <td>Fraud detection and payment processing on checkout pages</td>
            <td><a href="https://stripe.com/cookie-settings" class="legal-link" target="_blank" rel="noopener noreferrer">Stripe Cookie Settings</a></td>
          </tr>
          <tr>
