<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex,nofollow">
  <title><%= title %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #0d0d0d;
      color: #e8e0d0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
    }
    .login-card {
      background: #161616;
      border: 1px solid rgba(212, 175, 55, 0.15);
      border-radius: 12px;
      padding: 40px;
      max-width: 400px;
      width: 100%;
    }
    .login-brand {
      color: #d4af37;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 8px;
    }
    .login-title {
      font-size: 24px;
      font-weight: 700;
      color: #f0e8d8;
      margin-bottom: 24px;
    }
    .login-error {
      background: #1f0f0f;
      border: 1px solid rgba(235, 87, 87, 0.3);
      border-radius: 6px;
      padding: 10px 14px;
      font-size: 13px;
      color: #eb5757;
      margin-bottom: 20px;
    }
    .login-label {
      display: block;
      color: #888;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }
    .login-input {
      width: 100%;
      background: #0d0d0d;
      border: 1px solid rgba(212, 175, 55, 0.2);
      border-radius: 6px;
      padding: 12px 14px;
      color: #e8e0d0;
      font-size: 15px;
      font-family: monospace;
      outline: none;
      transition: border-color 0.2s;
    }
    .login-input:focus {
      border-color: #d4af37;
    }
    .login-btn {
      width: 100%;
      margin-top: 20px;
      padding: 12px;
      background: #d4af37;
      color: #0d0d0d;
      border: none;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      transition: background 0.2s;
    }
    .login-btn:hover {
      background: #e8c44a;
    }
    .login-footer {
      margin-top: 20px;
      text-align: center;
      font-size: 12px;
      color: #555;
    }
    .login-footer a {
      color: #888;
      text-decoration: none;
    }
    .login-footer a:hover {
      color: #d4af37;
    }
    .login-hint {
      font-size: 12px;
      color: #888;
      margin-bottom: 12px;
      line-height: 1.5;
    }
    .login-hint-sub {
      font-size: 11px;
      color: #666;
      margin-top: 16px;
      margin-bottom: 8px;
    }
    .token-display {
      background: #0d0d0d;
      border: 1px solid rgba(212, 175, 55, 0.25);
      border-radius: 6px;
      padding: 10px 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }
    .token-display code {
      font-family: monospace;
      font-size: 11px;
      color: #d4af37;
      word-break: break-all;
      flex: 1;
    }
    .copy-btn {
      background: #d4af37;
      color: #0d0d0d;
      border: none;
      border-radius: 4px;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s;
    }
    .copy-btn:hover { background: #e8c44a; }
    .copy-btn.copied { background: #2d6a4f; color: #fff; }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="login-brand">StickVault</div>
    <h1 class="login-title">Admin Access</h1>

    <% if (error === 'invalid') { %>
    <div class="login-error">Invalid token. Check the token below and try again.</div>
    <% } else if (error === 'not_configured') { %>
    <div class="login-error">Admin access not configured. Set ADMIN_TOKEN env var.</div>
    <% } %>

    <div class="login-hint">
      Bookmark this link to access the dashboard directly without re-entering the token:
    </div>
    <div class="token-display">
      <code id="direct-url">https://www.stickvault.com/admin/pinterest-dashboard?token=1e8bfd0755feed081f1d1619727f6e1f919fee395941b2d2442299206331b27e</code>
      <button class="copy-btn" onclick="copyUrl()" id="copy-btn">Copy</button>
    </div>
    <div class="login-hint-sub">Paste this token in the field below to authenticate:</div>

    <form method="POST" action="/admin/login">
      <input type="hidden" name="returnUrl" value="<%= returnUrl %>">
      <label class="login-label" for="token">Admin Token</label>
      <input type="password" id="token" name="token" class="login-input" placeholder="Paste token here" required autofocus autocomplete="current-password">
      <button type="submit" class="login-btn">Authenticate</button>
    </form>

    <div class="login-footer">
      <a href="/">&larr; Back to site</a>
    </div>
  </div>
</body>
<script>
  function copyUrl() {
    const code = document.getElementById('direct-url');
    navigator.clipboard.writeText(code.textContent).then(function() {
      var btn = document.getElementById('copy-btn');
      btn.textContent = 'Copied!';
      btn.classList.add('copied');
      setTimeout(function() {
        btn.textContent = 'Copy';
        btn.classList.remove('copied');
      }, 2000);
    });
  }

  // Auto-auth: if ?token= is in the URL, set the cookie directly and redirect.
  // requireAdmin uses ?return= (not ?returnUrl=), so read both params.
  (function() {
    var params = new URLSearchParams(window.location.search);
    var token = params.get('token');
    if (!token) return;

    // Read destination from redirect param (?return=) or fall back to pinterest-dashboard
    var returnTo = params.get('return') ||
      (document.querySelector('input[name="returnUrl"]') || {}).value ||
      '/admin/pinterest-dashboard';

    // Set the signed cookie (matches sv_admin in admin-auth.js)
    var cookieStr = 'sv_admin=' + token +
      '; path=/' +
      '; max-age=' + (7 * 24 * 60 * 60) +
      '; secure' +
      '; samesite=lax' +
      '; httpOnly';
    document.cookie = cookieStr;

    // Redirect to the intended destination
    window.location.href = returnTo;
  })();
</script>
</html>
